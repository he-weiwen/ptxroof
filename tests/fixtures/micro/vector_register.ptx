//
// HAND-WRITTEN: `ld.global.v2.b32 %v, [%rd1]` overwrites both elements of
// the vector register %v (PTX ISA §6.4.3), so `%v.x` after it holds the
// loaded value, not the thread index the earlier `mov.b32 %v.x, %r1`
// wrote (ptxas 13.4: `LDG.E R2, [R2.64]`, then `IMAD.WIDE.U32 R4, R2,
// R5, c[0x0][0x160]`).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_vector_register(
	.param .u64 micro_vector_register_param_0
)
.reqntid 32, 1, 1
{
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;
	.reg .v2 .b32 	%v;

	ld.param.u64 	%rd1, [micro_vector_register_param_0];
	mov.u32 	%r1, %tid.x;
	mov.b32 	%v.x, %r1;
	ld.global.v2.b32 	%v, [%rd1];
	mov.b32 	%r2, %v.x;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	ret;
}
