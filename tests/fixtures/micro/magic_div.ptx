//
// HAND-WRITTEN: thread t stores at param_0 + 4·⌊t/3⌋, the division by 3
// written as LLVM writes a division by a constant that is no power of
// two: the upper half of t·0xAAAAAAAB, shifted right by 1 (⌊t·
// ⌈2^33/3⌉ / 2^33⌋ = ⌊t/3⌋ for every 32-bit t). ptxas 13.4 (sm_89),
// R5 = %tid.x: `IMAD.HI.U32 R0, R5, -0x55555555, RZ`,
// `SHF.R.U32.HI R0, RZ, 0x1, R0`, `IMAD.WIDE.U32 R2, R0, R3, c[0x0][0x160]`.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_magic_div(
	.param .u64 micro_magic_div_param_0
)
.reqntid 96, 1, 1
{
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_magic_div_param_0];
	mov.u32 	%r1, %tid.x;
	mul.hi.u32 	%r2, %r1, -1431655765;
	shr.u32 	%r3, %r2, 1;
	mul.wide.u32 	%rd2, %r3, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	ret;
}
