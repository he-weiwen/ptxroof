//
// HAND-WRITTEN: two loops counting from 1 while the counter is below
// 10, 10 trips each. The first's latch is `setp.lo.u32`, unsigned
// "lower" (PTX ISA §9.7.6.2); the second's is `setp.lt.f16x2` of the
// counter's bits and 10's, whose low halves are positive subnormal
// halves, ordered as their bits are, and whose first output compares
// the low halves (§9.7.7.2).
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_latch_lo(
	.param .u64 micro_latch_lo_param_0
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<6>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_latch_lo_param_0];
	mov.u32 	%r1, 0;
	mov.u32 	%r5, 10;
$L__BB0_1:
	add.s32 	%r1, %r1, 1;
	st.global.u32 	[%rd1], %r1;
	setp.lo.u32 	%p1, %r1, %r5;
	@%p1 bra 	$L__BB0_1;
	ret;
}

.visible .entry micro_latch_f16x2(
	.param .u64 micro_latch_f16x2_param_0
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<6>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_latch_f16x2_param_0];
	mov.u32 	%r1, 0;
	mov.b32 	%r5, 10;
$L__BB1_1:
	add.s32 	%r1, %r1, 1;
	st.global.u32 	[%rd1], %r1;
	setp.lt.f16x2 	%p1|%p2, %r1, %r5;
	@%p1 bra 	$L__BB1_1;
	ret;
}
