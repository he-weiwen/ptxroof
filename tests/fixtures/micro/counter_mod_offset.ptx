//
// HAND-WRITTEN: a loop of 4 trips whose counter %r1 starts at 0 and is
// incremented after its use, `and.b32 %r2, %r1, 1` in between: trip k
// stores at param_0 + 4·((k − 1) mod 2), a[0], a[1], a[0], a[1], k12's
// double buffer `tile % 2`. ptxas 13.4 (sm_89) unrolls it into
// `STG.E [R2.64+0x4], R5`, `STG.E [R2.64], RZ`, `STG.E [R2.64], R7`,
// `STG.E [R2.64+0x4], R9`: 8 distinct bytes.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_counter_mod_offset(
	.param .u64 micro_counter_mod_offset_param_0
)
.reqntid 1, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_counter_mod_offset_param_0];
	mov.u32 	%r1, 0;
$L__BB0_1:
	and.b32 	%r2, %r1, 1;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	add.u32 	%r1, %r1, 1;
	setp.lt.u32 	%p1, %r1, 4;
	@%p1 bra 	$L__BB0_1;
	ret;
}
