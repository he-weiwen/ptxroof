//
// HAND-WRITTEN: bfe controls at the edges of PTX ISA §9.7.1.20, one
// warp. A field of length 0 is 0, so every thread stores at param_0; an
// unsigned field from bit 31 of 2 bits keeps bit 31 alone, 1, so every
// thread stores at param_0 + 4. A signed field from bit 32 of 1 bit is
// the sign bit, bit 31 of 2^31·(%tid.x & 1): with the position given at
// run time from param_1, odd threads store at param_0 + 4608 and even
// ones at param_0 + 4096; with it immediate, ptxas 13.4 folds the field
// to -1 and every thread stores at param_0 + 512.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_bfe_fields(
	.param .u64 micro_bfe_fields_param_0,
	.param .u32 micro_bfe_fields_param_1
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<14>;
	.reg .b64 	%rd<6>;

	ld.param.u64 	%rd1, [micro_bfe_fields_param_0];
	ld.param.u32 	%r10, [micro_bfe_fields_param_1];
	mov.u32 	%r1, %tid.x;
	mov.u32 	%r9, -1;
	bfe.s32 	%r2, %r9, 0, 0;
	setp.eq.s32 	%p1, %r2, 0;
	@%p1 st.global.u32 	[%rd1], %r1;
	bfe.u32 	%r3, %r9, 31, 2;
	setp.eq.u32 	%p2, %r3, 1;
	@%p2 st.global.u32 	[%rd1+4], %r1;
	and.b32 	%r4, %r1, 1;
	mul.lo.u32 	%r5, %r4, 2147483648;
	bfe.s32 	%r6, %r5, 32, 1;
	and.b32 	%r7, %r6, 128;
	mul.wide.u32 	%rd2, %r7, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	bfe.s32 	%r11, %r5, %r10, 1;
	and.b32 	%r12, %r11, 128;
	mul.wide.u32 	%rd4, %r12, 4;
	add.s64 	%rd5, %rd1, %rd4;
	st.global.u32 	[%rd5+4096], %r1;
	ret;
}
