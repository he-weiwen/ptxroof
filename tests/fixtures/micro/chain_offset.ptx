//
// HAND-WRITTEN: a counter carried through two registers, %r2 = %r1 + 2
// then %r1 = %r2 - 1, so %r1 steps by 1 from 0 and the loop runs 4
// trips. The store writes a[%r2], and on trip k %r2 is k + 1, so the
// address is param_0 + 4k + 4. ptxas 13.4 (sm_89) keeps the loop, from
// R0 = 0 (%r1) and R5 = 4:
//   IADD3 R2, R0.reuse, 0x2, RZ
//   IADD3 R0, R0, 0x1, RZ
//   IMAD.WIDE.U32 R2, R2, R5, c[0x0][0x160]
//   ISETP.GE.U32.AND P0, PT, R0, 0x4, PT
//   STG.E [R2.64], RZ
// storing at param_0 + 8, 12, 16 and 20. The induction search gives
// %r2 the chain's start and step, %r1's, without the 1 between them.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_chain_offset(
	.param .u64 micro_chain_offset_param_0
)
.reqntid 1, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_chain_offset_param_0];
	mov.u32 	%r1, 0;
$L__BB0_1:
	add.u32 	%r2, %r1, 2;
	add.s32 	%r1, %r2, -1;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], 0;
	setp.lt.u32 	%p1, %r1, 4;
	@%p1 bra 	$L__BB0_1;
	ret;
}
