//
// HAND-WRITTEN: a loop whose latch compares −2^63·k with −2^63, both
// −2^62 times 2: equal at k = 1, so the body runs once, in a block of
// one thread. ptxas 13.4 (sm_89) compares the high words, R0 = k:
//   IMAD.U32 R4, R0, -0x80000000, RZ
//   ISETP.NE.AND.EX P0, PT, R4, -0x80000000, PT, !PT
//   @P0 BRA 0x50
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_min_step(
	.param .u64 micro_min_step_param_0
)
.reqntid 1, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b64 	%rd<7>;

	ld.param.u64 	%rd1, [micro_min_step_param_0];
	mov.u64 	%rd2, 0;
	mov.u64 	%rd6, -4611686018427387904;
	shl.b64 	%rd6, %rd6, 1;
$L__loop:
	add.u64 	%rd2, %rd2, 1;
	mul.lo.s64 	%rd3, %rd2, -4611686018427387904;
	shl.b64 	%rd4, %rd3, 1;
	st.global.u32 	[%rd1], 0;
	setp.ne.s64 	%p1, %rd4, %rd6;
	@%p1 bra 	$L__loop;
	ret;
}
