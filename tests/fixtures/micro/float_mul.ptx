//
// HAND-WRITTEN: a float multiply of an integer's bit pattern: %f1 holds
// %tid.x's bits, a subnormal for every thread but 0, and %f2 4's bits,
// another subnormal; their product underflows to 0 (PTX ISA §9.7.3.5),
// so every thread stores at param_0.
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_float_mul(
	.param .u64 micro_float_mul_param_0
)
.reqntid 64, 1, 1
{
	.reg .b32 	%r<4>;
	.reg .f32 	%f<4>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_float_mul_param_0];
	mov.u32 	%r1, %tid.x;
	mov.b32 	%f1, %r1;
	mov.b32 	%f2, 4;
	mul.f32 	%f3, %f1, %f2;
	mov.b32 	%r2, %f3;
	cvt.u64.u32 	%rd2, %r2;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	ret;
}
