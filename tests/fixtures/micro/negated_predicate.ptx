//
// HAND-WRITTEN: the latch's `setp.lt.and.s32 %p1, %r2, 10, !%p2` takes a
// negated predicate source (PTX ISA §9.7.6.2, `{!}c`), so it is a
// comparison combined with a predicate, and %p1 is its result.
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_negated_predicate(
	.param .u64 micro_negated_predicate_param_0,
	.param .u32 micro_negated_predicate_param_1
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_negated_predicate_param_0];
	ld.param.u32 	%r1, [micro_negated_predicate_param_1];
	setp.eq.s32 	%p2, %r1, 7;
	mov.u32 	%r2, 0;
$L__loop:
	st.global.u32 	[%rd1], %r2;
	add.s32 	%r2, %r2, 1;
	setp.lt.and.s32 	%p1, %r2, 10, !%p2;
	@%p1 bra 	$L__loop;
	ret;
}
