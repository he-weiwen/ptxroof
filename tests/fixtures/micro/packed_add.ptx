//
// HAND-WRITTEN: `add.s16x2` adds the two halves of 0xffff and the
// thread index apart (PTX ISA §9.7.1.1), so the low half of thread
// t >= 1 is t - 1 and the high half 0; the sum indexes the store.
//
.version 8.7
.target sm_90
.address_size 64

.visible .entry micro_packed_add(
	.param .u64 micro_packed_add_param_0
)
.reqntid 32, 1, 1
{
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_packed_add_param_0];
	mov.u32 	%r1, %tid.x;
	mov.u32 	%r2, 65535;
	add.s16x2 	%r3, %r2, %r1;
	mul.wide.u32 	%rd2, %r3, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	ret;
}
