//
// HAND-WRITTEN: micro/exit_pred.ptx's micro_exit_pred_addr with the
// counter scaled by a parameter: lane t stores at 4·stride·max(t, 1)
// after a loop it leaves after max(t, 1) iterations, one address for
// the warp when stride is 0.
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_exit_pred_stride(
	.param .u64 out,
	.param .u32 stride
)
.reqntid 64, 1, 1
{
	.reg .pred %p<2>;
	.reg .b32 %r<5>;
	.reg .b64 %rd<4>;

	ld.param.u64 %rd1, [out];
	ld.param.u32 %r4, [stride];
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, 0;
$L__BB0_1:
	add.s32 %r2, %r2, 1;
	setp.lt.u32 %p1, %r2, %r1;
	@%p1 bra $L__BB0_1;
	mul.lo.s32 %r3, %r2, %r4;
	mul.wide.u32 %rd2, %r3, 4;
	add.s64 %rd3, %rd1, %rd2;
	st.global.u32 [%rd3], %r1;
	ret;
}
