//
// HAND-WRITTEN: Triton's swizzled shared offset ((t << 4) & 2032) ^
// ((t << 1) & 48) (gluon/fp8_gemm_kernel.c_fc.sm_89.ptx:213) as a shared
// address, each thread storing the offset to param_0[t]: on an RTX 4090
// thread t writes 16·(t mod 128) ⊕ 16·(⌊t/8⌋ mod 4), threads 0..7 0, 16,
// …, 112, threads 8..15 144, 128, 176, 160, 208, 192, 240, 224. In
// micro_xor_overlap one side of the xor is (t & 3) + 2·(t & 1), whose
// fields share bit 1, so its sum is not their xor.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_xor_swizzle(
	.param .u64 micro_xor_swizzle_param_0
)
.reqntid 128, 1, 1
{
	.reg .b32 	%r<10>;
	.reg .b64 	%rd<4>;
	.shared .align 16 .b8 buf[4096];

	ld.param.u64 	%rd1, [micro_xor_swizzle_param_0];
	mov.u32 	%r1, %tid.x;
	shl.b32 	%r2, %r1, 4;
	and.b32 	%r3, %r2, 2032;
	shl.b32 	%r4, %r1, 1;
	and.b32 	%r5, %r4, 48;
	xor.b32 	%r6, %r3, %r5;
	mov.u32 	%r7, buf;
	add.s32 	%r8, %r7, %r6;
	st.shared.u32 	[%r8+64], %r1;
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r6;
	ret;
}

.visible .entry micro_xor_overlap(
	.param .u64 micro_xor_overlap_param_0
)
.reqntid 128, 1, 1
{
	.reg .b32 	%r<12>;
	.reg .b64 	%rd<4>;
	.shared .align 16 .b8 buf[4096];

	ld.param.u64 	%rd1, [micro_xor_overlap_param_0];
	mov.u32 	%r1, %tid.x;
	and.b32 	%r2, %r1, 3;
	and.b32 	%r3, %r1, 1;
	shl.b32 	%r4, %r3, 1;
	add.s32 	%r5, %r2, %r4;
	xor.b32 	%r6, %r5, 12;
	shl.b32 	%r7, %r6, 2;
	mov.u32 	%r8, buf;
	add.s32 	%r9, %r8, %r7;
	st.shared.u32 	[%r9], %r1;
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r6;
	ret;
}
