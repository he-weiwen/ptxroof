//
// HAND-WRITTEN: 32-bit `setp` on values that wrap (PTX ISA §9.7.6.2).
// In the first kernel %tid.x << 28 wraps at 2^32, and as a signed value
// it is below 2^28 on the threads with %tid.x mod 16 equal to 0 or 8 to
// 15 (ptxas 13.4: `SHF.L.U32 R0, R5, 0x1c, RZ`, `ISETP.GE.AND P0, PT,
// R0, 0x10000000, PT`, `@P0 EXIT`). In the second %tid.x + 0xfffffff0
// is %tid.x - 16 mod 2^32, zero on thread 16 (ptxas 13.4: `IADD3 R0,
// R5, -0x10, RZ`, `ISETP.NE.U32.AND P0, PT, R0, RZ, PT`, `@P0 EXIT`).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_setp_wraps_signed(
	.param .u64 micro_setp_wraps_signed_param_0
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_setp_wraps_signed_param_0];
	mov.u32 	%r1, %tid.x;
	shl.b32 	%r2, %r1, 28;
	setp.lt.s32 	%p1, %r2, 268435456;
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p1 st.global.u32 	[%rd3], %r1;
	ret;
}

.visible .entry micro_setp_wraps_eq(
	.param .u64 micro_setp_wraps_eq_param_0
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_setp_wraps_eq_param_0];
	mov.u32 	%r1, %tid.x;
	add.u32 	%r2, %r1, 0xFFFFFFF0;
	setp.eq.u32 	%p1, %r2, 0;
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p1 st.global.u32 	[%rd3], %r1;
	ret;
}
