//
// HAND-WRITTEN: a store at 4·((4·k) | (%tid.x << 8)) in a loop of n
// trips. The `or` is an add only while 4·k stays below 256, k ≤ 63
// (PTX ISA §9.7.8.2), so the address reads only where the trip count,
// and so the counter's range, is known. ptxas 13.4 -arch=sm_89 keeps the
// `LOP3.LUT` of the two in a loop it unrolls by 4. On an RTX 4090 with
// n = 32 the store requests 4,096 L2 sectors, 32 per warp request over
// 32 trips and 4 warps (micro/counter_range_bound.ncu.json).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_counter_range_bound(
	.param .u64 micro_counter_range_bound_param_0,
	.param .u32 micro_counter_range_bound_param_1
)
.reqntid 128, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_counter_range_bound_param_0];
	ld.param.u32 	%r1, [micro_counter_range_bound_param_1];
	mov.u32 	%r2, %tid.x;
	shl.b32 	%r3, %r2, 8;
	setp.lt.s32 	%p1, %r1, 1;
	@%p1 bra 	$L__BB0_3;
	mov.u32 	%r4, 0;
$L__BB0_2:
	add.s32 	%r4, %r4, 1;
	shl.b32 	%r5, %r4, 2;
	or.b32 	%r6, %r5, %r3;
	mul.wide.u32 	%rd2, %r6, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r4;
	setp.lt.s32 	%p2, %r4, %r1;
	@%p2 bra 	$L__BB0_2;
$L__BB0_3:
	ret;
}
