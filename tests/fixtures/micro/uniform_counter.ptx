//
// HAND-WRITTEN: loop counters and other values around a quotient by a
// parameter, u = %ctaid.x / param_1, which the tracer does not read:
// - micro_uniform_start_div: a counter whose start is that `div`;
// - micro_uniform_start_copy: a counter starting at a copy of u, so
//   thread t stores at param_0 + 4t + 256·(u + k − 1) on trip k; after
//   the loop's 4 trips it stores at param_0 + 4t + 256·(u + 4), and
//   after a second loop that thread t leaves after t + 1 trips, each
//   thread at its own counter;
// - micro_uniform_start_outer: the same counter in a loop of 2 trips
//   that computes u from %ctaid.x plus its own counter;
// - micro_uniform_inner_bound: an outer counter stepped by an inner loop
//   that runs u trips;
// - micro_uniform_differences: u − u, which is 0, and u − w for
//   w = %ctaid.y / param_1;
// - micro_uniform_one_line: u and w written on one PTX line.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_uniform_start_div(
	.param .u64 micro_uniform_start_div_param_0,
	.param .u32 micro_uniform_start_div_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_uniform_start_div_param_0];
	ld.param.u32 	%r1, [micro_uniform_start_div_param_1];
	mov.u32 	%r2, %tid.x;
	mov.u32 	%r3, %ctaid.x;
	div.u32 	%r4, %r3, %r1;
	mov.u32 	%r7, 0;
$L__BB0_1:
	mad.lo.s32 	%r5, %r4, 64, %r2;
	mul.wide.u32 	%rd2, %r5, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r2;
	add.s32 	%r4, %r4, 1;
	add.s32 	%r7, %r7, 1;
	setp.lt.u32 	%p1, %r7, 4;
	@%p1 bra 	$L__BB0_1;
	ret;
}

.visible .entry micro_uniform_start_copy(
	.param .u64 micro_uniform_start_copy_param_0,
	.param .u32 micro_uniform_start_copy_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<12>;
	.reg .b64 	%rd<8>;

	ld.param.u64 	%rd1, [micro_uniform_start_copy_param_0];
	ld.param.u32 	%r1, [micro_uniform_start_copy_param_1];
	mov.u32 	%r2, %tid.x;
	mov.u32 	%r3, %ctaid.x;
	div.u32 	%r4, %r3, %r1;
	add.s32 	%r6, %r4, 0;
	mov.u32 	%r7, 0;
$L__BB1_1:
	mad.lo.s32 	%r5, %r6, 64, %r2;
	mul.wide.u32 	%rd2, %r5, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r2;
	add.s32 	%r6, %r6, 1;
	add.s32 	%r7, %r7, 1;
	setp.lt.u32 	%p1, %r7, 4;
	@%p1 bra 	$L__BB1_1;
	mad.lo.s32 	%r8, %r6, 64, %r2;
	mul.wide.u32 	%rd4, %r8, 4;
	add.s64 	%rd5, %rd1, %rd4;
	st.global.u32 	[%rd5], %r2;
	mov.u32 	%r9, 0;
$L__BB1_3:
	add.s32 	%r6, %r6, 1;
	add.s32 	%r9, %r9, 1;
	setp.le.u32 	%p2, %r9, %r2;
	@%p2 bra 	$L__BB1_3;
	mad.lo.s32 	%r10, %r6, 64, %r2;
	mul.wide.u32 	%rd6, %r10, 4;
	add.s64 	%rd7, %rd1, %rd6;
	st.global.u32 	[%rd7], %r2;
	ret;
}

.visible .entry micro_uniform_start_outer(
	.param .u64 micro_uniform_start_outer_param_0,
	.param .u32 micro_uniform_start_outer_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<11>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_uniform_start_outer_param_0];
	ld.param.u32 	%r1, [micro_uniform_start_outer_param_1];
	mov.u32 	%r2, %tid.x;
	mov.u32 	%r3, %ctaid.x;
	mov.u32 	%r9, 0;
$L__BB2_1:
	add.s32 	%r10, %r3, %r9;
	div.u32 	%r4, %r10, %r1;
	add.s32 	%r6, %r4, 0;
	mov.u32 	%r7, 0;
$L__BB2_2:
	mad.lo.s32 	%r5, %r6, 64, %r2;
	mul.wide.u32 	%rd2, %r5, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r2;
	add.s32 	%r6, %r6, 1;
	add.s32 	%r7, %r7, 1;
	setp.lt.u32 	%p1, %r7, 4;
	@%p1 bra 	$L__BB2_2;
	add.s32 	%r9, %r9, 1;
	setp.lt.u32 	%p2, %r9, 2;
	@%p2 bra 	$L__BB2_1;
	ret;
}

.visible .entry micro_uniform_inner_bound(
	.param .u64 micro_uniform_inner_bound_param_0,
	.param .u32 micro_uniform_inner_bound_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<11>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_uniform_inner_bound_param_0];
	ld.param.u32 	%r1, [micro_uniform_inner_bound_param_1];
	mov.u32 	%r2, %tid.x;
	mov.u32 	%r3, %ctaid.x;
	div.u32 	%r4, %r3, %r1;
	mov.u32 	%r6, 0;
	mov.u32 	%r9, 0;
$L__BB3_1:
	mad.lo.s32 	%r5, %r6, 64, %r2;
	mul.wide.u32 	%rd2, %r5, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r2;
	mov.u32 	%r7, 0;
$L__BB3_2:
	add.s32 	%r6, %r6, 1;
	add.s32 	%r7, %r7, 1;
	setp.lt.u32 	%p1, %r7, %r4;
	@%p1 bra 	$L__BB3_2;
	add.s32 	%r9, %r9, 1;
	setp.lt.u32 	%p2, %r9, 2;
	@%p2 bra 	$L__BB3_1;
	ret;
}

.visible .entry micro_uniform_differences(
	.param .u64 micro_uniform_differences_param_0,
	.param .u32 micro_uniform_differences_param_1
)
.reqntid 64, 1, 1
{
	.reg .b32 	%r<12>;
	.reg .b64 	%rd<6>;

	ld.param.u64 	%rd1, [micro_uniform_differences_param_0];
	ld.param.u32 	%r1, [micro_uniform_differences_param_1];
	mov.u32 	%r2, %tid.x;
	mov.u32 	%r3, %ctaid.x;
	div.u32 	%r4, %r3, %r1;
	mov.u32 	%r5, %ctaid.y;
	div.u32 	%r6, %r5, %r1;
	sub.s32 	%r7, %r4, %r4;
	mad.lo.s32 	%r8, %r7, 64, %r2;
	mul.wide.s32 	%rd2, %r8, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r2;
	sub.s32 	%r9, %r4, %r6;
	mad.lo.s32 	%r10, %r9, 64, %r2;
	mul.wide.s32 	%rd4, %r10, 4;
	add.s64 	%rd5, %rd1, %rd4;
	st.global.u32 	[%rd5], %r2;
	ret;
}

.visible .entry micro_uniform_one_line(
	.param .u64 micro_uniform_one_line_param_0,
	.param .u32 micro_uniform_one_line_param_1
)
.reqntid 64, 1, 1
{
	.reg .b32 	%r<10>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_uniform_one_line_param_0];
	ld.param.u32 	%r1, [micro_uniform_one_line_param_1];
	mov.u32 	%r2, %tid.x;
	mov.u32 	%r3, %ctaid.x;
	mov.u32 	%r5, %ctaid.y;
	div.u32 	%r4, %r3, %r1; div.u32 	%r6, %r5, %r1;
	add.s32 	%r7, %r4, %r6;
	mad.lo.s32 	%r8, %r7, 64, %r2;
	mul.wide.u32 	%rd2, %r8, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r2;
	ret;
}
