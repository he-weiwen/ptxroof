//
// HAND-WRITTEN: guards on a loop counter k (trips 1 to 8, %r3 = k - 1).
// The barrier runs on trips 3 to 8, where the counter alone passes
// `k - 1 < 2`; the store, Triton's masked `64·(k - 1) + %tid.x < n`,
// runs on the lanes the mask admits at each trip: with n = 300, 64
// threads on trips 1 to 4 and 44 on trip 5. ptxas 13.4 -arch=sm_89
// predicates both (`ISETP.GE.U32.AND P0, PT, R0, 0x2, PT` then `@P0
// BAR.SYNC.DEFER_BLOCKING`, `ISETP.GE.U32.AND P1, PT, R7, c[0x0][0x168],
// PT` then `@!P1 STG.E`) in a rolled loop. On an RTX 4090 with n = 300
// the barrier runs 6 times per thread and the store 300 times
// (micro/counter_guard.ncu.json).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_counter_guard(
	.param .u64 micro_counter_guard_param_0,
	.param .u32 micro_counter_guard_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<6>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_counter_guard_param_0];
	ld.param.u32 	%r1, [micro_counter_guard_param_1];
	mov.u32 	%r2, %tid.x;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	mov.u32 	%r3, 0;
$L__BB0_1:
	setp.lt.u32 	%p1, %r3, 2;
	@%p1 bra 	$L__BB0_3;
	bar.sync 	0;
$L__BB0_3:
	shl.b32 	%r4, %r3, 6;
	add.s32 	%r5, %r4, %r2;
	setp.ge.u32 	%p2, %r5, %r1;
	@%p2 bra 	$L__BB0_5;
	st.global.u32 	[%rd3], %r5;
$L__BB0_5:
	add.s32 	%r3, %r3, 1;
	setp.lt.u32 	%p3, %r3, 8;
	@%p3 bra 	$L__BB0_1;
	ret;
}
