//
// HAND-WRITTEN: %r3 is set to 0, then overwritten by a vector load of a
// per-thread address (the default-then-load shape Triton emits), and
// the loaded value guards a store. The vector load is %r3's definition,
// so the guard is unknown and the store's threads a bound, not all 64.
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_vector_def(
	.param .u64 micro_vector_def_param_0
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<5>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_vector_def_param_0];
	mov.u32 	%r1, %tid.x;
	mul.wide.u32 	%rd2, %r1, 8;
	add.s64 	%rd3, %rd1, %rd2;
	mov.u32 	%r3, 0;
	ld.global.v2.u32 	{%r3, %r4}, [%rd3];
	setp.eq.u32 	%p1, %r3, 0;
	@%p1 st.global.u32 	[%rd3], %r1;
	ret;
}
