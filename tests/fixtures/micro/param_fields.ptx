//
// HAND-WRITTEN: a guard compares the two 32-bit fields of a by-value
// 8-byte parameter, loaded at offsets 0 and 4. The fields may differ,
// so the store's threads are not known.
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_param_fields(
	.param .u64 micro_param_fields_param_0,
	.param .align 8 .b8 micro_param_fields_param_1[8]
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_param_fields_param_0];
	mov.u32 	%r1, %tid.x;
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	ld.param.u32 	%r2, [micro_param_fields_param_1];
	ld.param.u32 	%r3, [micro_param_fields_param_1+4];
	setp.eq.u32 	%p1, %r2, %r3;
	@%p1 st.global.u32 	[%rd3], %r1;
	ret;
}
