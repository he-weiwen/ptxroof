//
// HAND-WRITTEN: a store at param_0 + 4·(2^24·%ctaid.x + %tid.x), the
// product a 32-bit `mul.lo.u32`. PTX ISA §9.7.1.3: `.lo` keeps the low
// 32 bits, so from CTA 256 on the product wraps, and CTA 256 stores at
// param_0 + 4·%tid.x, as CTA 0 does. ptxas 13.4 (sm_89) computes it in
// 32 bits and widens after (R2 = %ctaid.x, R5 = %tid.x, R3 = 4):
//   LEA R2, R2, R5, 0x18
//   IMAD.WIDE.U32 R2, R2, R3, c[0x0][0x160]
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_grid_wrap(
	.param .u64 micro_grid_wrap_param_0
)
.reqntid 32, 1, 1
{
	.reg .b32 	%r<5>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_grid_wrap_param_0];
	mov.u32 	%r1, %ctaid.x;
	mov.u32 	%r2, %tid.x;
	mul.lo.u32 	%r3, %r1, 16777216;
	add.u32 	%r4, %r3, %r2;
	mul.wide.u32 	%rd2, %r4, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r2;
	ret;
}
