//
// HAND-WRITTEN: single_loop.ptx plus one instruction the classifier
// does not model (a wgmma fence) inside the loop. What that instruction
// computes or moves is unknown, so every flop and global/shared byte
// total in the loop's scope is a lower bound and AI(global) has no
// direction; the loop's own counts stay as they are.
//
.version 8.7
.target sm_90a
.address_size 64

.visible .entry micro_unknown_in_loop(
	.param .u64 micro_unknown_in_loop_param_0,
	.param .u32 micro_unknown_in_loop_param_1
)
{
	.reg .pred 	%p<3>;
	.reg .f32 	%f<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;
	.loc	1 3 0

	ld.param.u64 	%rd1, [micro_unknown_in_loop_param_0];
	ld.param.u32 	%r1, [micro_unknown_in_loop_param_1];
	cvta.to.global.u64 	%rd2, %rd1;
	setp.lt.s32 	%p1, %r1, 1;
	@%p1 bra 	$L__BB0_3;

	mov.u32 	%r2, 0;
	mov.u64 	%rd3, %rd2;

$L__BB0_2:
	.loc	1 5 9
	ld.global.f32 	%f1, [%rd3];
	fma.rn.f32 	%f2, %f1, %f1, 0f3F800000;
	wgmma.fence.sync.aligned;
	st.global.f32 	[%rd3], %f2;
	.loc	1 4 5
	add.s64 	%rd3, %rd3, 4;
	add.s32 	%r2, %r2, 1;
	setp.lt.s32 	%p2, %r2, %r1;
	@%p2 bra 	$L__BB0_2;

$L__BB0_3:
	.loc	1 7 1
	ret;

}
	.file	1 "micro/unknown_in_loop.cu"
