//
// HAND-WRITTEN: blocks that an `or` of two conditions selects, whose
// branches are off the block's dominator chain.
// - micro_or_entry: `if (tid < 64) { if (n != 0 || m != 0) bar.sync 1, 64
//   }`, n and m loaded from param_0. ptxas 13.4 -arch=sm_89 keeps both
//   branches (`ISETP.NE.AND`, `@P0 BRA`, `ISETP.NE.AND`, `@!P0 EXIT`)
//   before the `BAR.SYNC.DEFER_BLOCKING 0x1, 0x40`. On an RTX 4090 with
//   param_0's memory zeroed (n = m = 0) no thread reaches the barrier
//   (micro/or_entry.ncu.json).
// - micro_or_entry_loop: an outer loop of 4 trips whose threads below 64
//   run an inner loop of 3 trips when n != 0 or m != 0, and else leave
//   the outer loop.
// - micro_or_entry_footprint: `if (tid < 64) { if (tid < 16 || tid >= 48)
//   for 4 trips store }`: 32 threads store, 512 B.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_or_entry(
	.param .u64 micro_or_entry_param_0
)
.reqntid 128, 1, 1
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<3>;

	ld.param.u64 	%rd2, [micro_or_entry_param_0];
	ld.global.u32 	%r1, [%rd2];
	ld.global.u32 	%r2, [%rd2+4];
	mov.u32 	%r3, %tid.x;
	setp.ge.u32 	%p1, %r3, 64;
	@%p1 bra 	$L__BB0_4;
	setp.ne.s32 	%p2, %r1, 0;
	@%p2 bra 	$L__BB0_3;
	setp.eq.s32 	%p3, %r2, 0;
	@%p3 bra 	$L__BB0_4;
$L__BB0_3:
	bar.sync 	1, 64;
$L__BB0_4:
	ret;
}

.visible .entry micro_or_entry_loop(
	.param .u64 micro_or_entry_loop_param_0
)
.reqntid 128, 1, 1
{
	.reg .pred 	%p<6>;
	.reg .b32 	%r<6>;
	.reg .b64 	%rd<3>;

	ld.param.u64 	%rd2, [micro_or_entry_loop_param_0];
	ld.global.u32 	%r1, [%rd2];
	ld.global.u32 	%r2, [%rd2+4];
	mov.u32 	%r3, %tid.x;
	mov.u32 	%r4, 0;
$L__BB1_1:
	setp.ge.u32 	%p1, %r3, 64;
	@%p1 bra 	$L__BB1_5;
	setp.ne.s32 	%p2, %r1, 0;
	@%p2 bra 	$L__BB1_3;
	setp.eq.s32 	%p3, %r2, 0;
	@%p3 bra 	$L__BB1_6;
$L__BB1_3:
	mov.u32 	%r5, 0;
$L__BB1_4:
	add.s32 	%r5, %r5, 1;
	bar.sync 	1, 64;
	setp.lt.s32 	%p4, %r5, 3;
	@%p4 bra 	$L__BB1_4;
$L__BB1_5:
	add.s32 	%r4, %r4, 1;
	setp.lt.s32 	%p5, %r4, 4;
	@%p5 bra 	$L__BB1_1;
$L__BB1_6:
	ret;
}

.visible .entry micro_or_entry_footprint(
	.param .u64 micro_or_entry_footprint_param_0
)
.reqntid 128, 1, 1
{
	.reg .pred 	%p<5>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_or_entry_footprint_param_0];
	mov.u32 	%r1, %tid.x;
	setp.ge.u32 	%p1, %r1, 64;
	@%p1 bra 	$L__BB2_5;
	setp.lt.u32 	%p2, %r1, 16;
	@%p2 bra 	$L__BB2_3;
	setp.lt.u32 	%p3, %r1, 48;
	@%p3 bra 	$L__BB2_5;
$L__BB2_3:
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	mov.u32 	%r2, 0;
$L__BB2_4:
	add.s32 	%r2, %r2, 1;
	st.global.u32 	[%rd3], %r2;
	setp.lt.s32 	%p4, %r2, 4;
	@%p4 bra 	$L__BB2_4;
$L__BB2_5:
	ret;
}
