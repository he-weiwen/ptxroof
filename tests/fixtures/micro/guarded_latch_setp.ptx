//
// HAND-WRITTEN: a latch comparison that only lanes below 32 run, under
// a guard, while %p2 starts false: lanes 0-31 leave the loop after 4
// trips, lanes 32-63 keep the false and leave after 1, and the store
// after it writes a[4] or a[1]. ptxas 13.4 (sm_89) keeps the old value
// for lanes 32-63,
//   ISETP.GE.U32.AND P2, PT, R0, 0x20, P0
//   ISETP.LT.U32.AND P0, PT, R2, 0x4, !P1
//   PLOP3.LUT P0, PT, P0, P2, PT, 0xa8, 0x0
// with P0 false before the loop. Read as if every lane compared, the
// loop ran 4 trips and the store was at param_0 + 16 for every lane.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_guarded_latch_setp(
	.param .u64 micro_guarded_latch_setp_param_0
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_guarded_latch_setp_param_0];
	mov.u32 	%r1, %tid.x;
	setp.lt.u32 	%p1, %r1, 32;
	setp.ne.u32 	%p2, %r1, %r1;
	mov.u32 	%r3, 0;
$L__BB0_1:
	add.u32 	%r3, %r3, 1;
	@%p1 setp.lt.u32 	%p2, %r3, 4;
	@%p2 bra 	$L__BB0_1;
	mul.wide.u32 	%rd2, %r3, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], 0;
	ret;
}
