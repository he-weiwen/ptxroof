//
// HAND-WRITTEN: two stores in a loop of one trip, at param_0 +
// 4·(m + n + %tid.x) and param_0 + 4·(n + m + %tid.x): one address
// whose sum is written in either order (ptxas 13.4, sm_89, computes it
// once, `IADD3 R2, R2, c[0x0][0x168], R3`, and keeps one `STG.E`).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_commuted_sum(
	.param .u64 micro_commuted_sum_param_0,
	.param .u32 micro_commuted_sum_param_1,
	.param .u32 micro_commuted_sum_param_2
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<10>;
	.reg .b64 	%rd<6>;

	ld.param.u64 	%rd1, [micro_commuted_sum_param_0];
	ld.param.u32 	%r1, [micro_commuted_sum_param_1];
	ld.param.u32 	%r2, [micro_commuted_sum_param_2];
	mov.u32 	%r5, %tid.x;
	add.s32 	%r3, %r1, %r2;
	add.s32 	%r4, %r2, %r1;
	add.s32 	%r6, %r3, %r5;
	add.s32 	%r7, %r4, %r5;
	mul.wide.u32 	%rd2, %r6, 4;
	add.s64 	%rd3, %rd1, %rd2;
	mul.wide.u32 	%rd4, %r7, 4;
	add.s64 	%rd5, %rd1, %rd4;
	mov.u32 	%r9, 0;
$L__BB0_1:
	add.s32 	%r9, %r9, 1;
	st.global.u32 	[%rd3], %r9;
	st.global.u32 	[%rd5], %r9;
	setp.lt.u32 	%p1, %r9, 1;
	@%p1 bra 	$L__BB0_1;
	ret;
}
