//
// HAND-WRITTEN: a store on lane 1 if it is the elected lane of warp 0
// (sm_90). PTX ISA §9.7.14.15: elect.sync "elects one predicated active
// leader thread", the same one "for the same membermask every time",
// without saying which; with .reqntid 32 the store runs on lane 1 or on
// no thread, so 4 B in one sector or nothing.
//
.version 8.7
.target sm_90
.address_size 64

.visible .entry micro_elect_lane(
	.param .u64 micro_elect_lane_param_0
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_elect_lane_param_0];
	cvta.to.global.u64 	%rd2, %rd1;
	mov.u32 	%r1, %tid.x;
	elect.sync 	%r2|%p1, -1;
	setp.eq.u32 	%p2, %r1, 1;
	and.pred 	%p3, %p2, %p1;
	@%p3 st.global.b32 	[%rd2], %r1;
	ret;
}
