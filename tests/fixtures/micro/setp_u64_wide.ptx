//
// HAND-WRITTEN: a 64-bit `setp` whose operand passes 2^63 on part of
// the block: %tid.x << 54 is below 2^64 for every %tid.x below 1024,
// and above 0 on every thread but thread 0, which alone skips the
// store (ptxas 13.4 compares the high word, `SHF.L.U32 R0, R5, 0x16,
// RZ`, `ISETP.GT.U32.AND.EX P0, PT, R0, RZ, PT, !PT`, `@!P0 EXIT`).
// The value from thread 512 on is at least 2^63: evaluated in i64 it
// went negative, and the store ran on 511 threads.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_setp_u64_wide(
	.param .u64 micro_setp_u64_wide_param_0
)
.reqntid 1024, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<6>;

	ld.param.u64 	%rd1, [micro_setp_u64_wide_param_0];
	mov.u32 	%r1, %tid.x;
	cvt.u64.u32 	%rd2, %r1;
	shl.b64 	%rd3, %rd2, 54;
	setp.gt.u64 	%p1, %rd3, 0;
	mul.wide.u32 	%rd4, %r1, 4;
	add.s64 	%rd5, %rd1, %rd4;
	@%p1 st.global.u32 	[%rd5], %r1;
	ret;
}
