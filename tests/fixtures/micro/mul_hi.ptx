//
// HAND-WRITTEN: `mul.hi.u32 %r2, %r1, 3` with %r1 = 2, then a store to
// a[%r2]. The high 32 bits of 2 * 3 are 0 (PTX ISA §9.7.1.3: d =
// t<2n-1..n> for .hi), so the store writes a[0]: ptxas 13.4 (sm_89)
// emits
//   STG.E [R2.64], RZ
// with R2 = param_0. Then `mad.hi.u32 %r3, %r1, 3, 1`: the high half of
// 6 plus 1 is 1 (PTX ISA §9.7.1.4: d = t<2n-1..n> + c for .hi), so the
// second store writes a[1]; ptxas keeps an `IMAD.HI.U32` for it, so the
// manual is the evidence. The tracer refuses both upper halves, and
// reads each value, the same on every thread, as a uniform variable.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_mul_hi(
	.param .u64 micro_mul_hi_param_0
)
.reqntid 1, 1, 1
{
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<6>;

	ld.param.u64 	%rd1, [micro_mul_hi_param_0];
	mov.u32 	%r1, 2;
	mul.hi.u32 	%r2, %r1, 3;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], 0;
	mad.hi.u32 	%r3, %r1, 3, 1;
	mul.wide.u32 	%rd4, %r3, 4;
	add.s64 	%rd5, %rd1, %rd4;
	st.global.u32 	[%rd5], 0;
	ret;
}
