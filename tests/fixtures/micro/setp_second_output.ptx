//
// HAND-WRITTEN: micro_setp_second_latch: the latch branches on the
// second output of `setp.eq.s32 %p1|%p2, %r1, 4`, its complement (PTX
// ISA §9.7.6.2), so the loop runs while %r1 ≠ 4: 4 trips. ptxas 13.4
// (sm_89) reads `ISETP.NE.AND P0, PT, R5, 0x4, PT`, `@P0 BRA 0x30`; an
// RTX 4090 run stores 4.
// micro_pred_copy: a store guarded by `mov.pred %p2, %p1` of %p1 =
// %tid.x < 4; ptxas keeps `ISETP.GE.U32.AND P0, PT, R2, 0x4, PT` before
// its `STG.E`; an RTX 4090 run of 32 threads sets words 0 to 3.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_setp_second_latch(
	.param .u64 micro_setp_second_latch_param_0
)
.reqntid 1, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_setp_second_latch_param_0];
	mov.u32 	%r1, 0;
$L__BB0_1:
	add.s32 	%r1, %r1, 1;
	setp.eq.s32 	%p1|%p2, %r1, 4;
	@%p2 bra 	$L__BB0_1;
	st.global.u32 	[%rd1], %r1;
	ret;
}

.visible .entry micro_pred_copy(
	.param .u64 micro_pred_copy_param_0
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_pred_copy_param_0];
	mov.u32 	%r1, %tid.x;
	setp.lt.u32 	%p1, %r1, 4;
	mov.pred 	%p2, %p1;
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p2 st.global.u32 	[%rd3], 1;
	ret;
}
