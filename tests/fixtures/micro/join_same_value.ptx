//
// HAND-WRITTEN: in blocks of 128 and a grid of 1 x 2, each kernel
// branches on %ctaid.y = 0, writes %r7 on both paths and stores it at
// param_0 plus 4 times a form of it. The words written, measured on an
// RTX 4090 (ptxas 13.4, sm_89):
// - micro_join_same_tid, the shape of census kernel 00004.ptx: both
//   paths write %tid.x, the one of %ctaid.y = 0 also storing %ctaid.y at
//   word 128 from thread 0; the threads with bit 6 of %r7 clear store %r7
//   at word 64·%ctaid.y + (%r7 mod 64): words 0 to 63 and 64 to 127 hold
//   0 to 63, word 128 holds 0.
// - micro_join_two_values: the paths write %tid.x + 128 (%ctaid.y = 0)
//   and %tid.x, stored at word 256·%ctaid.y + %r7: words 128 to 255 hold
//   128 to 255, words 256 to 383 hold 0 to 127.
// - micro_join_counter, the shape of census kernel 00376.ptx: in a loop
//   of 2 trips, i = 0, 1, both paths write 128·i + %tid.x, stored at
//   that word: words 0 to 255 hold 0 to 255.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_join_same_tid(
	.param .u64 micro_join_same_tid_param_0
)
.reqntid 128, 1, 1
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_join_same_tid_param_0];
	mov.u32 	%r1, %ctaid.y;
	setp.eq.s32 	%p1, %r1, 0;
	@%p1 bra 	$L__BB0_2;
	mov.u32 	%r7, %tid.x;
	bra.uni 	$L__BB0_3;
$L__BB0_2:
	mov.u32 	%r7, %tid.x;
	setp.eq.s32 	%p2, %r7, 0;
	@%p2 st.global.u32 	[%rd1+512], %r1;
$L__BB0_3:
	and.b32 	%r2, %r7, 63;
	shl.b32 	%r3, %r1, 6;
	add.s32 	%r4, %r3, %r2;
	mul.wide.u32 	%rd2, %r4, 4;
	add.s64 	%rd3, %rd1, %rd2;
	and.b32 	%r5, %r7, 64;
	setp.eq.s32 	%p3, %r5, 0;
	@%p3 st.global.u32 	[%rd3], %r7;
	ret;
}

.visible .entry micro_join_two_values(
	.param .u64 micro_join_two_values_param_0
)
.reqntid 128, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_join_two_values_param_0];
	mov.u32 	%r1, %ctaid.y;
	setp.eq.s32 	%p1, %r1, 0;
	@%p1 bra 	$L__BB1_2;
	mov.u32 	%r7, %tid.x;
	bra.uni 	$L__BB1_3;
$L__BB1_2:
	mov.u32 	%r2, %tid.x;
	add.s32 	%r7, %r2, 128;
$L__BB1_3:
	shl.b32 	%r3, %r1, 8;
	add.s32 	%r4, %r3, %r7;
	mul.wide.u32 	%rd2, %r4, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r7;
	ret;
}

.visible .entry micro_join_counter(
	.param .u64 micro_join_counter_param_0
)
.reqntid 128, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_join_counter_param_0];
	mov.u32 	%r1, %ctaid.y;
	mov.u32 	%r6, %tid.x;
	mov.u32 	%r2, 0;
$L__BB2_1:
	setp.eq.s32 	%p1, %r1, 0;
	@%p1 bra 	$L__BB2_3;
	shl.b32 	%r3, %r2, 7;
	add.s32 	%r7, %r3, %r6;
	bra.uni 	$L__BB2_4;
$L__BB2_3:
	shl.b32 	%r4, %r2, 7;
	add.s32 	%r7, %r4, %r6;
$L__BB2_4:
	mul.wide.u32 	%rd2, %r7, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r7;
	add.s32 	%r2, %r2, 1;
	setp.lt.u32 	%p2, %r2, 2;
	@%p2 bra 	$L__BB2_1;
	ret;
}
