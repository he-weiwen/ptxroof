	.reg .b32 	%r<8>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_and_select_or_param_0];
	mov.u32 	%r1, %tid.x;
	and.b32 	%r2, %r1, 1;
	neg.s32 	%r3, %r2;
	and.b32 	%r4, %r3, 2080;
	and.b32 	%r5, %r1, 8;
	shl.b32 	%r6, %r5, 4;
	or.b32 	%r7, %r6, %r4;
	mul.wide.u32 	%rd2, %r7, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	ret;
}

