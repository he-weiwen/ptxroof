	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_and_select_grid_param_0];
	mov.u32 	%r1, %tid.x;
	mov.u32 	%r2, %ctaid.x;
	and.b32 	%r3, %r2, 1;
	neg.s32 	%r4, %r3;
	and.b32 	%r5, %r4, 576;
	mul.wide.u32 	%rd2, %r5, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
