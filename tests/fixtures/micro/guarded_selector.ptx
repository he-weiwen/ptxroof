//
// HAND-WRITTEN: two stores guarded on %r3 < 32, %r3 written under a
// guard on the parameter n.
//
// micro_guarded_selector: %r3 is 100, or %tid.x when n is 0, so the
// store runs on 32 of the 64 threads when n is 0 and on none
// otherwise. ptxas 13.4 (sm_89) selects the value and exits the
// threads at or above 32:
//   ISETP.NE.U32.AND P0, PT, RZ, c[0x0][0x168], PT
//   SEL R0, R5, 0x64, !P0
//   ISETP.GE.U32.AND P0, PT, R0, 0x20, PT
//   @P0 EXIT
//   STG.E [R2.64], R5
//
// micro_guarded_selector_agreeing: both writes are %tid.x, so the store
// runs on 32 threads whatever n is:
//   ISETP.GT.U32.AND P0, PT, R5, 0x1f, PT
//   @P0 EXIT
//   STG.E [R2.64], R5
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_guarded_selector(
	.param .u64 micro_guarded_selector_param_0,
	.param .u32 micro_guarded_selector_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_guarded_selector_param_0];
	ld.param.u32 	%r1, [micro_guarded_selector_param_1];
	mov.u32 	%r2, %tid.x;
	mov.u32 	%r3, 100;
	setp.eq.u32 	%p1, %r1, 0;
	@%p1 mov.u32 	%r3, %r2;
	setp.lt.u32 	%p2, %r3, 32;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p2 st.global.u32 	[%rd3], %r2;
	ret;
}

.visible .entry micro_guarded_selector_agreeing(
	.param .u64 micro_guarded_selector_agreeing_param_0,
	.param .u32 micro_guarded_selector_agreeing_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_guarded_selector_agreeing_param_0];
	ld.param.u32 	%r1, [micro_guarded_selector_agreeing_param_1];
	mov.u32 	%r2, %tid.x;
	mov.u32 	%r3, %r2;
	setp.eq.u32 	%p1, %r1, 0;
	@%p1 mov.u32 	%r3, %r2;
	setp.lt.u32 	%p2, %r3, 32;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p2 st.global.u32 	[%rd3], %r2;
	ret;
}
