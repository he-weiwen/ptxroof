//
// HAND-WRITTEN: selp of two constants by a comparison of %tid.x's bit 4
// (PTX ISA §9.7.6.2, §9.7.6.3), one warp, each store at
// 4·%tid.x + the choice: 64 for the upper half takes 4 sectors, 64 for
// the lower half 2, so a choice read the wrong way round changes them.
// The choice by setp.eq against 0, by the second output of setp.ne
// (its complement) and by setp.eq against 16 is 64·bit 4 or 64 − that;
// one by a setp.and is not read.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_selp_bits(
	.param .u64 micro_selp_bits_param_0
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<7>;
	.reg .b32 	%r<16>;
	.reg .b64 	%rd<12>;

	ld.param.u64 	%rd1, [micro_selp_bits_param_0];
	mov.u32 	%r1, %tid.x;
	shl.b32 	%r10, %r1, 2;
	and.b32 	%r2, %r1, 16;
	setp.eq.b32 	%p1, %r2, 0;
	selp.b32 	%r3, 0, 64, %p1;
	add.s32 	%r11, %r10, %r3;
	cvt.u64.u32 	%rd2, %r11;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	setp.ne.b32 	%p2|%p3, %r2, 0;
	selp.b32 	%r4, 64, 0, %p3;
	add.s32 	%r12, %r10, %r4;
	cvt.u64.u32 	%rd4, %r12;
	add.s64 	%rd5, %rd1, %rd4;
	st.global.u32 	[%rd5+1024], %r1;
	setp.eq.b32 	%p4, %r2, 16;
	selp.b32 	%r5, 64, 0, %p4;
	add.s32 	%r13, %r10, %r5;
	cvt.u64.u32 	%rd6, %r13;
	add.s64 	%rd7, %rd1, %rd6;
	st.global.u32 	[%rd7+2048], %r1;
	setp.eq.and.b32 	%p5, %r2, 0, %p1;
	selp.b32 	%r6, 0, 64, %p5;
	add.s32 	%r14, %r10, %r6;
	cvt.u64.u32 	%rd8, %r14;
	add.s64 	%rd9, %rd1, %rd8;
	st.global.u32 	[%rd9+3072], %r1;
	ret;
}
