//
// HAND-WRITTEN: in a block of 32 threads, `%tid.x & 63` is %tid.x, below
// 32, so its `or` with 32 sets no bit both sides set and is their sum:
// the store is at param_0 + 128 + 4·%tid.x. ptxas 13.4 (sm_89) keeps
// `LOP3.LUT R0, R0, 0x3f, RZ, 0xc0, !PT` and `LOP3.LUT R0, R0, 0x20,
// RZ, 0xfc, !PT`; an RTX 4090 run sets words 32 to 63: 128 bytes, 4
// sectors.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_or_mod_range(
	.param .u64 micro_or_mod_range_param_0
)
.reqntid 32, 1, 1
{
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_or_mod_range_param_0];
	mov.u32 	%r1, %tid.x;
	and.b32 	%r2, %r1, 63;
	or.b32 	%r3, %r2, 32;
	mul.wide.u32 	%rd2, %r3, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], 1;
	ret;
}
