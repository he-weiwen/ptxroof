//
// HAND-WRITTEN: thread 0 of each CTA of 32 stores 4 B at param_0;
// ptxas 13.4 (sm_89) exits the other threads (R5 = %tid.x):
//   ISETP.NE.U32.AND P0, PT, R5, RZ, PT
//   @P0 EXIT
//   STG.E [R2.64], R5
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_lane0_store(
	.param .u64 micro_lane0_store_param_0
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_lane0_store_param_0];
	mov.u32 	%r1, %tid.x;
	setp.eq.u32 	%p1, %r1, 0;
	@%p1 st.global.u32 	[%rd1], %r1;
	ret;
}
