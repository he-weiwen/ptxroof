//
// HAND-WRITTEN: `shfl.sync.idx` from lane 5 with the control 127, a
// clamp value c[4:0] of 31 and a segment mask c[12:8] of 0 (PTX ISA
// §9.7.9.6), as 31 reads: every lane reads lane 5's %tid.x. ptxas 13.4
// (sm_89) keeps `SHFL.IDX PT, R2, R0, 0x5, 0x7f`; an RTX 4090 run of
// 64 threads sets words 5 and 37.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_shfl_whole_warp_control(
	.param .u64 micro_shfl_whole_warp_control_param_0
)
.reqntid 64, 1, 1
{
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_shfl_whole_warp_control_param_0];
	mov.u32 	%r1, %tid.x;
	shfl.sync.idx.b32 	%r2, %r1, 5, 127, -1;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], 1;
	ret;
}
