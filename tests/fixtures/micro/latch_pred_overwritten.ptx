//
// HAND-WRITTEN: the latch's `setp` would continue while %r1 < 10, but
// `and.pred` then clears the predicate where %p2 is false, and %p2 is
// %r1 != 3, so the loop runs 3 times, not 10 (ptxas 13.4 folds it to
// one `STG.E [R2.64], R5` with R5 = 0x2, the third iteration's value).
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_latch_pred_overwritten(
	.param .u64 micro_latch_pred_overwritten_param_0
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_latch_pred_overwritten_param_0];
	mov.u32 	%r1, 0;
$L__loop:
	st.global.u32 	[%rd1], %r1;
	add.s32 	%r1, %r1, 1;
	setp.lt.s32 	%p1, %r1, 10;
	setp.ne.s32 	%p2, %r1, 3;
	and.pred 	%p1, %p1, %p2;
	@%p1 bra 	$L__loop;
	ret;
}
