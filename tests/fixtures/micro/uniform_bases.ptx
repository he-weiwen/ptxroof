	mad.lo.s32 	%r10, %r7, 128, %r8;
	mul.wide.u32 	%rd4, %r10, 4;
	add.s64 	%rd5, %rd1, %rd4;
	@%p2 st.global.u32 	[%rd5], %r2;
	add.s32 	%r3, %r3, 1;
	setp.lt.u32 	%p1, %r3, 4;
	@%p1 bra 	$L__BB1_1;
