//
// HAND-WRITTEN: in-loop data-dependent conditional (PLAN.md, S9.2).
// Each iteration runs one fma unconditionally and one more under an
// @%p guard, so the conditional block's counts carry at_most and every
// aggregate that sums them inherits the marker (rendered <=).
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_branchy(
	.param .u64 micro_branchy_param_0,
	.param .u32 micro_branchy_param_1
)
{
	.reg .pred 	%p<4>;
	.reg .f32 	%f<5>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;
	.loc	1 3 0

	ld.param.u64 	%rd1, [micro_branchy_param_0];
	ld.param.u32 	%r1, [micro_branchy_param_1];
	cvta.to.global.u64 	%rd2, %rd1;
	setp.lt.s32 	%p1, %r1, 1;
	@%p1 bra 	$L__BB0_5;

	mov.u32 	%r2, 0;
	mov.u64 	%rd3, %rd2;

$L__BB0_2:
	.loc	1 5 9
	ld.global.f32 	%f1, [%rd3];
	fma.rn.f32 	%f4, %f1, %f1, 0f3F800000;
	.loc	1 6 9
	setp.lt.f32 	%p2, %f1, 0f00000000;
	@%p2 bra 	$L__BB0_4;

	.loc	1 7 13
	fma.rn.f32 	%f4, %f4, %f1, 0f40000000;

$L__BB0_4:
	.loc	1 8 9
	st.global.f32 	[%rd3], %f4;
	add.s64 	%rd3, %rd3, 4;
	.loc	1 4 5
	add.s32 	%r2, %r2, 1;
	setp.lt.s32 	%p3, %r2, %r1;
	@%p3 bra 	$L__BB0_2;

$L__BB0_5:
	.loc	1 10 1
	ret;

}
	.file	1 "micro/branchy.cu"
