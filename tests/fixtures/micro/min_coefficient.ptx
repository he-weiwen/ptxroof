//
// HAND-WRITTEN: stores at an address with a coefficient or an offset of
// −2^63, in a block of one thread. ptxas 13.4 (sm_89) folds %tid.x = 0
// and stores at param_0 in the first two kernels, R2 = param_0:
//   STG.E [R2.64], RZ
//
// micro_min_coefficient: param_0 + (−2^62·%tid.x)·2, mul.lo.s64 then
// shl.b64.
// micro_min_negated: the same negated, neg.s64.
// micro_min_base: param_0 + (−2^62)·2, −2^63 added to the high word:
//   UIADD3.X UR5, UR5, -0x80000000, URZ, UP0, !UPT
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_min_coefficient(
	.param .u64 micro_min_coefficient_param_0
)
.reqntid 1, 1, 1
{
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<6>;

	ld.param.u64 	%rd1, [micro_min_coefficient_param_0];
	mov.u32 	%r1, %tid.x;
	cvt.u64.u32 	%rd2, %r1;
	mul.lo.s64 	%rd3, %rd2, -4611686018427387904;
	shl.b64 	%rd4, %rd3, 1;
	add.s64 	%rd5, %rd1, %rd4;
	st.global.u32 	[%rd5], %r1;
	ret;
}

.visible .entry micro_min_negated(
	.param .u64 micro_min_negated_param_0
)
.reqntid 1, 1, 1
{
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<7>;

	ld.param.u64 	%rd1, [micro_min_negated_param_0];
	mov.u32 	%r1, %tid.x;
	cvt.u64.u32 	%rd2, %r1;
	mul.lo.s64 	%rd3, %rd2, -4611686018427387904;
	shl.b64 	%rd4, %rd3, 1;
	neg.s64 	%rd5, %rd4;
	add.s64 	%rd6, %rd1, %rd5;
	st.global.u32 	[%rd6], %r1;
	ret;
}

.visible .entry micro_min_base(
	.param .u64 micro_min_base_param_0
)
.reqntid 1, 1, 1
{
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<5>;

	ld.param.u64 	%rd1, [micro_min_base_param_0];
	mov.u32 	%r1, %tid.x;
	mov.u64 	%rd2, -4611686018427387904;
	shl.b64 	%rd3, %rd2, 1;
	add.s64 	%rd4, %rd1, %rd3;
	st.global.u32 	[%rd4], %r1;
	ret;
}
