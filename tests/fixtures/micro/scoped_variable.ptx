//
// HAND-WRITTEN: the block's `.shared` array `buf` hides the kernel's
// register `buf` (PTX ISA §9.7.13.1), so `mov.u64 %rd2, buf` there takes
// the array's address, the same in every thread, not the register's
// 4 * %tid.x (ptxas 13.4: `STG.E [R2.64], R5` with R2 = c[0x0][0x160],
// param_0, the array being at address 0).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_scoped_variable(
	.param .u64 micro_scoped_variable_param_0
)
.reqntid 32, 1, 1
{
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<4>;
	.reg .b64 	buf;

	ld.param.u64 	%rd1, [micro_scoped_variable_param_0];
	mov.u32 	%r1, %tid.x;
	mul.wide.u32 	buf, %r1, 4;
	{
	.shared .align 4 .b8 buf[128];
	mov.u64 	%rd2, buf;
	}
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	ret;
}
