//
// HAND-WRITTEN: a loop of n / d trips, both parameters, as LLVM rotates
// it: a guard skips it when the quotient is below 1 (`setp.lt.s32`), then
// a do-while counts up to the quotient (PTX ISA §9.7.1.9 `div.u32`).
// ptxas 13.4 -arch=sm_89 divides by the parameter (`I2F.U32.RP`,
// `MUFU.RCP` and the `IMAD.HI.U32` correction) before the guard's
// `ISETP.GE.AND P0, PT, R4, 0x1` and `@!P0 EXIT`, and keeps the loop
// rolled around its `BAR.SYNC.DEFER_BLOCKING`, one per trip. On an RTX
// 4090 with n = 20 and d = 4 the barrier runs 5 times per thread
// (micro/trip_div_param.ncu.json).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_trip_div_param(
	.param .u64 micro_trip_div_param_param_0,
	.param .u32 micro_trip_div_param_param_1,
	.param .u32 micro_trip_div_param_param_2
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<6>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_trip_div_param_param_0];
	ld.param.u32 	%r1, [micro_trip_div_param_param_1];
	ld.param.u32 	%r2, [micro_trip_div_param_param_2];
	div.u32 	%r3, %r1, %r2;
	setp.lt.s32 	%p1, %r3, 1;
	@%p1 bra 	$L__BB0_3;
	mov.u32 	%r4, 0;
$L__BB0_2:
	add.s32 	%r4, %r4, 1;
	st.global.u32 	[%rd1], %r4;
	bar.sync 	0;
	setp.lt.s32 	%p2, %r4, %r3;
	@%p2 bra 	$L__BB0_2;
$L__BB0_3:
	ret;
}
