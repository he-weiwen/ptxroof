.visible .entry micro_setp_unknown_range_mask(
	.param .u64 micro_setp_unknown_range_mask_param_0,
	.param .u32 micro_setp_unknown_range_mask_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<5>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_setp_unknown_range_mask_param_0];
	ld.param.u32 	%r1, [micro_setp_unknown_range_mask_param_1];
	mov.u32 	%r2, %tid.x;
	and.b32 	%r3, %r1, 2147483647;
	setp.lt.s32 	%p1, %r1, %r3;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p1 st.global.u32 	[%rd3], %r2;
	ret;
}

.visible .entry micro_setp_unknown_range_hi(
	.param .u64 micro_setp_unknown_range_hi_param_0,
	.param .u32 micro_setp_unknown_range_hi_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<5>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_setp_unknown_range_hi_param_0];
	ld.param.u32 	%r1, [micro_setp_unknown_range_hi_param_1];
	mov.u32 	%r2, %tid.x;
	add.s32 	%r3, %r1, %r2;
	add.s32 	%r4, %r1, 32;
	setp.hi.u32 	%p1, %r4, %r3;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p1 st.global.u32 	[%rd3], %r2;
	ret;
}
