//
// HAND-WRITTEN: the first two kernels compare n + %tid.x with n + 32 for
// a parameter n of unknown range. Under the input contract (PLAN.md)
// n + %tid.x does not wrap, so the signed comparison is %tid.x < 32,
// and so is the unsigned one with n taken as nonnegative: a negative n,
// as C's `(unsigned)i < n` allows, would change it, n = -8 leaving out
// threads 0 to 7. ptxas 13.4 keeps both sums (`IADD3 R0, R5,
// c[0x0][0x168]`, `ISETP.GE.AND` and `ISETP.GE.U32.AND` against
// n + 32), which differ from %tid.x < 32 only where n + %tid.x wraps
// or, unsigned, where n is negative. The third sums in `.u32` and
// compares `.s32`, read as %tid.x < 32: the contract excludes
// n = 0x7fffffe0, which makes n + 32 the signed minimum and the store
// run on no thread. The fourth is read wrong (PLAN.md, wrong output):
// it compares n with n & 0x7fffffff, true where n is negative. The
// fifth compares n + 32 `hi` n + %tid.x, the second's comparison with
// its operands swapped (ptxas 13.4: `ISETP.LT.U32.AND P0, PT, R0, UR4,
// PT`, `@!P0 EXIT`).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_setp_unknown_range_signed(
	.param .u64 micro_setp_unknown_range_signed_param_0,
	.param .u32 micro_setp_unknown_range_signed_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<5>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_setp_unknown_range_signed_param_0];
	ld.param.u32 	%r1, [micro_setp_unknown_range_signed_param_1];
	mov.u32 	%r2, %tid.x;
	add.s32 	%r3, %r1, %r2;
	add.s32 	%r4, %r1, 32;
	setp.lt.s32 	%p1, %r3, %r4;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p1 st.global.u32 	[%rd3], %r2;
	ret;
}

.visible .entry micro_setp_unknown_range_unsigned(
	.param .u64 micro_setp_unknown_range_unsigned_param_0,
	.param .u32 micro_setp_unknown_range_unsigned_param_1
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<5>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_setp_unknown_range_unsigned_param_0];
	ld.param.u32 	%r1, [micro_setp_unknown_range_unsigned_param_1];
	mov.u32 	%r2, %tid.x;
	add.s32 	%r3, %r1, %r2;
	add.s32 	%r4, %r1, 32;
	setp.lt.u32 	%p1, %r3, %r4;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p1 st.global.u32 	[%rd3], %r2;
	ret;
}

