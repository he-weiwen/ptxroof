	ld.param.u32 	%r1, [micro_setp_unknown_range_mixed_param_1];
	mov.u32 	%r2, %tid.x;
	add.u32 	%r3, %r1, %r2;
	add.u32 	%r4, %r1, 32;
	setp.lt.s32 	%p1, %r3, %r4;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
