//
// HAND-WRITTEN: a guard whose comparison reads a register written under
// a %tid.x guard. Lanes 0..15 set %r2 to 5 and store; the others keep
// 0 and skip the store. The tracer reads %r2 as 5 (it does not model
// guarded writes), so the comparison is 0 == 0; the uniformity analysis
// finds it divergent, and the store's threads stay a bound.
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_guarded_def(
	.param .u64 micro_guarded_def_param_0
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_guarded_def_param_0];
	mov.u32 	%r1, %tid.x;
	setp.lt.u32 	%p1, %r1, 16;
	mov.u32 	%r2, 0;
	@%p1 mov.u32 	%r2, 5;
	setp.eq.u32 	%p2, %r2, 5;
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p2 st.global.u32 	[%rd3], %r1;
	ret;
}
