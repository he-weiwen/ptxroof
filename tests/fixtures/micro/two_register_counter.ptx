//
// HAND-WRITTEN: LLVM's two-register loop counter, the shape an earlier
// Triton build gave the fp8 GEMM's K loop (see PLAN.md, trip shapes).
// The counter lives in two registers: the body computes t = i + 1 into
// a temporary, the latch compares t with the bound and copies it back
// (`mov.b64 %rd4, %rd6`) for the next iteration; i itself is only ever
// initialised before the loop and copied in the latch. The increment
// sits in the header block, the compare in the latch block. Trips = n
// (param 1), guarded against n = 0.
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_two_register_counter(
	.param .u64 micro_two_register_counter_param_0,
	.param .u32 micro_two_register_counter_param_1
)
{
	.reg .pred 	%p<4>;
	.reg .f32 	%f<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<8>;
	.loc	1 3 0

	ld.param.u64 	%rd1, [micro_two_register_counter_param_0];
	ld.param.u32 	%r1, [micro_two_register_counter_param_1];
	cvta.to.global.u64 	%rd2, %rd1;
	cvt.u64.u32 	%rd3, %r1;
	setp.eq.s32 	%p1, %r1, 0;
	@%p1 bra 	$L__BB0_4;

	mov.b64 	%rd4, 0;
	mov.u64 	%rd5, %rd2;

$L__BB0_2:
	.loc	1 5 9
	ld.global.f32 	%f1, [%rd5];
	fma.rn.f32 	%f2, %f1, %f1, 0f3F800000;
	add.s64 	%rd6, %rd4, 1;
	setp.lt.u64 	%p2, %rd6, %rd3;
	@%p2 bra 	$L__BB0_3;

	st.global.f32 	[%rd5], %f2;

$L__BB0_3:
	.loc	1 4 5
	add.s64 	%rd5, %rd5, 4;
	setp.ne.b64 	%p3, %rd6, %rd3;
	mov.b64 	%rd4, %rd6;
	@%p3 bra 	$L__BB0_2;

$L__BB0_4:
	.loc	1 7 1
	ret;

}
	.file	1 "micro/two_register_counter.cu"
