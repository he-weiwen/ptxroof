//
// HAND-WRITTEN: `mul.lo.s32 %r2, %r1, 4` with %r1 = 2^30, then a store
// to a[%r2], widened by `mul.wide.u32`. The low 32 bits of 2^32 are 0
// (PTX ISA §9.7.1.3: d = t<n-1..0> for .lo), so the store writes a[0]:
// ptxas 13.4 (sm_89) emits
//   STG.E [R2.64], RZ
// with R2 = param_0. The tracer computes the product without
// wrapping it to 32 bits.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_mul_wrap(
	.param .u64 micro_mul_wrap_param_0
)
.reqntid 1, 1, 1
{
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_mul_wrap_param_0];
	mov.u32 	%r1, 1073741824;
	mul.lo.s32 	%r2, %r1, 4;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], 0;
	ret;
}
