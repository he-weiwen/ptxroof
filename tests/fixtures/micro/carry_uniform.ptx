//
// HAND-WRITTEN: `addc` reads the carry flag `add.cc` wrote (PTX ISA
// §9.7.2), here the carry out of two parameters' sum, so the branch on
// it sends every thread the same way (ptxas 13.4: `IADD3 RZ, P0, R0,
// c[0x0][0x16c], RZ` with R0 = c[0x0][0x168], then `@P0 EXIT` before
// any `SR_TID` read).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_carry_uniform(
	.param .u64 micro_carry_uniform_param_0,
	.param .u32 micro_carry_uniform_param_1,
	.param .u32 micro_carry_uniform_param_2
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<6>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_carry_uniform_param_0];
	ld.param.u32 	%r1, [micro_carry_uniform_param_1];
	ld.param.u32 	%r2, [micro_carry_uniform_param_2];
	mov.u32 	%r3, %tid.x;
	add.cc.u32 	%r4, %r1, %r2;
	addc.u32 	%r5, 0, 0;
	setp.ne.u32 	%p1, %r5, 0;
	@%p1 bra 	$L__skip;
	mul.wide.u32 	%rd2, %r3, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r3;
$L__skip:
	ret;
}
