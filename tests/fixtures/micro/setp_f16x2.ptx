//
// HAND-WRITTEN: `setp.lt.f16x2 p|q` writes the comparison of the upper
// halves to q (PTX ISA §9.7.7.2), here 0 < 0 for every thread, so the
// store under @%p2 never runs (ptxas 13.4: `HSETP2.LT.AND P0, PT,
// R5.H1_H1, RZ.H0_H0, PT` then `@!P0 EXIT`).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_setp_f16x2(
	.param .u64 micro_setp_f16x2_param_0
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_setp_f16x2_param_0];
	mov.u32 	%r1, %tid.x;
	mov.b32 	%r2, 0;
	setp.lt.f16x2 	%p1|%p2, %r1, %r2;
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p2 st.global.u32 	[%rd3], %r1;
	ret;
}
