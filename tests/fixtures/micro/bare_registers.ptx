//
// HAND-WRITTEN: %r2 packs two fp8 conversions of the thread index
// through registers declared without `%` in a nested scope (the shape
// of Gluon's fp8 conversions), so only thread 0 has %r2 == 0 and runs
// the store.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_bare_registers(
	.param .u64 micro_bare_registers_param_0
)
.reqntid 64, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<3>;
	.reg .f32 	%f<2>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_bare_registers_param_0];
	mov.u32 	%r1, %tid.x;
	cvt.rn.f32.u32 	%f1, %r1;
	{ .reg .b16 lo, hi; cvt.rn.satfinite.e4m3x2.f32 lo, %f1, %f1; cvt.rn.satfinite.e4m3x2.f32 hi, %f1, %f1; mov.b32 %r2, {lo, hi}; }
	setp.eq.u32 	%p1, %r2, 0;
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	@%p1 st.global.u32 	[%rd3], %r1;
	ret;
}
