//
// HAND-WRITTEN: a loop whose latch is `setp.lt.ftz.f32` on the bits of
// its counter and of 10, all subnormal: `.ftz` flushes subnormal inputs
// to zero (PTX ISA §9.7.6.2), so 0 < 0 ends the loop after one
// iteration (ptxas 13.4: `IADD3 R5, R5, 0x1, RZ`, `FSETP.GEU.FTZ.AND
// P0, PT, R5, 1.4012984643248170709e-44, PT`, `STG.E [R2.64], R5`,
// `@!P0 BRA`; on an RTX 4090 the stored counter is 1).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_latch_float(
	.param .u64 micro_latch_float_param_0
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<4>;
	.reg .f32 	%f<3>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_latch_float_param_0];
	mov.u32 	%r1, 0;
	mov.u32 	%r3, 10;
	mov.b32 	%f2, %r3;
$L__BB0_1:
	add.s32 	%r1, %r1, 1;
	st.global.u32 	[%rd1], %r1;
	mov.b32 	%f1, %r1;
	setp.lt.ftz.f32 	%p1, %f1, %f2;
	@%p1 bra 	$L__BB0_1;
	ret;
}
