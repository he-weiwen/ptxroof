//
// HAND-WRITTEN: a loop of 4 trips that stores a[%r1], loads a pointer
// from param_1 and stores %r1 through it: 4 + 8 + 4 B a trip, 64 B
// requested. ptxas 13.4 (sm_89) unrolls it into four of
//   STG.E [R4.64+4i], RZ
//   LDG.E.64 Rp, [R6.64]
//   STG.E [Rp.64], Rv
// with R4 = param_0 and R6 = param_1. The address of the store through
// the loaded pointer is unknown, and the loop's footprint leaves it out.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_footprint_unknown(
	.param .u64 micro_footprint_unknown_param_0,
	.param .u64 micro_footprint_unknown_param_1
)
.reqntid 1, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<6>;

	ld.param.u64 	%rd1, [micro_footprint_unknown_param_0];
	ld.param.u64 	%rd5, [micro_footprint_unknown_param_1];
	mov.u32 	%r1, 0;
$L__BB0_1:
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], 0;
	ld.global.u64 	%rd4, [%rd5];
	st.global.u32 	[%rd4], %r1;
	add.u32 	%r1, %r1, 1;
	setp.lt.u32 	%p1, %r1, 4;
	@%p1 bra 	$L__BB0_1;
	ret;
}
