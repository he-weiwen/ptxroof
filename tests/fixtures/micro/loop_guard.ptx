//
// HAND-WRITTEN: rotated loops as LLVM writes them, a guard branch before
// a do-while whose counter runs from 10 below n. micro_loop_guard's guard
// skips the loop when n < 11, the latch condition at k = 0: the loop
// runs n − 10 trips when n > 10, none otherwise. micro_loop_guard_other's
// guard skips it when n < 6 only, so at n in 6..10 the do-while runs once.
// ptxas 13.4 -arch=sm_89 keeps each guard (`ISETP.GE.AND P0, PT, R0,
// 0xb` and `0x6`, then `@!P0 EXIT`) and the loop rolled around its
// `BAR.SYNC.DEFER_BLOCKING`. On an RTX 4090 with n = 20,
// micro_loop_guard's barrier runs 10 times per thread
// (micro/loop_guard.ncu.json).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_loop_guard(
	.param .u64 micro_loop_guard_param_0,
	.param .u32 micro_loop_guard_param_1
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_loop_guard_param_0];
	ld.param.u32 	%r1, [micro_loop_guard_param_1];
	setp.lt.s32 	%p1, %r1, 11;
	@%p1 bra 	$L__BB0_3;
	mov.u32 	%r2, 10;
$L__BB0_2:
	add.s32 	%r2, %r2, 1;
	st.global.u32 	[%rd1], %r2;
	bar.sync 	0;
	setp.lt.s32 	%p2, %r2, %r1;
	@%p2 bra 	$L__BB0_2;
$L__BB0_3:
	ret;
}

.visible .entry micro_loop_guard_other(
	.param .u64 micro_loop_guard_other_param_0,
	.param .u32 micro_loop_guard_other_param_1
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_loop_guard_other_param_0];
	ld.param.u32 	%r1, [micro_loop_guard_other_param_1];
	setp.lt.s32 	%p1, %r1, 6;
	@%p1 bra 	$L__BB1_3;
	mov.u32 	%r2, 10;
$L__BB1_2:
	add.s32 	%r2, %r2, 1;
	st.global.u32 	[%rd1], %r2;
	bar.sync 	0;
	setp.lt.s32 	%p2, %r2, %r1;
	@%p2 bra 	$L__BB1_2;
$L__BB1_3:
	ret;
}
