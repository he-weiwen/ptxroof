//
// HAND-WRITTEN: a predicate set in a loop whose exit depends on %tid.x,
// read after the loop. Lane t runs max(t, 1) iterations of a counter i
// that every active lane shares, so its last %p3 = i < 16 holds for
// lanes 0..16 only: warp 0 stores 68 B (3 sectors), warp 1 nothing.
// Nsight Compute on sm_89, one CTA: STG.E executes for 17 threads in
// each kernel, `@P2 EXIT` for the other 47.
// The first two kernels differ only in how %r3 copies i (xor, which
// the tracer does not read, and add, which it does). The third stores
// at 4·i after the loop: lane t at 4·max(t, 1), 4 sectors in warp 0.
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_exit_pred_xor(
	.param .u64 out
)
.reqntid 64, 1, 1
{
	.reg .pred %p<4>;
	.reg .b32 %r<4>;
	.reg .b64 %rd<4>;

	ld.param.u64 %rd1, [out];
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, 0;
$L__BB0_1:
	xor.b32 %r3, %r2, 0;
	setp.ge.u32 %p2, %r3, 16;
	not.pred %p3, %p2;
	add.s32 %r2, %r2, 1;
	setp.lt.u32 %p1, %r2, %r1;
	@%p1 bra $L__BB0_1;
	mul.wide.u32 %rd2, %r1, 4;
	add.s64 %rd3, %rd1, %rd2;
	@%p3 st.global.u32 [%rd3], %r1;
	ret;
}

.visible .entry micro_exit_pred_add(
	.param .u64 out
)
.reqntid 64, 1, 1
{
	.reg .pred %p<4>;
	.reg .b32 %r<4>;
	.reg .b64 %rd<4>;

	ld.param.u64 %rd1, [out];
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, 0;
$L__BB1_1:
	add.s32 %r3, %r2, 0;
	setp.ge.u32 %p2, %r3, 16;
	not.pred %p3, %p2;
	add.s32 %r2, %r2, 1;
	setp.lt.u32 %p1, %r2, %r1;
	@%p1 bra $L__BB1_1;
	mul.wide.u32 %rd2, %r1, 4;
	add.s64 %rd3, %rd1, %rd2;
	@%p3 st.global.u32 [%rd3], %r1;
	ret;
}

.visible .entry micro_exit_pred_addr(
	.param .u64 out
)
.reqntid 64, 1, 1
{
	.reg .pred %p<2>;
	.reg .b32 %r<3>;
	.reg .b64 %rd<4>;

	ld.param.u64 %rd1, [out];
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, 0;
$L__BB2_1:
	add.s32 %r2, %r2, 1;
	setp.lt.u32 %p1, %r2, %r1;
	@%p1 bra $L__BB2_1;
	mul.wide.u32 %rd2, %r2, 4;
	add.s64 %rd3, %rd1, %rd2;
	st.global.u32 [%rd3], %r1;
	ret;
}
