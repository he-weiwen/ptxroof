//
// HAND-WRITTEN: data-dependent loop bound (PLAN.md, S9.1).
// The latch predicate is computed from a value loaded inside the loop
// (a pointer-chase shape), so no static trip count exists. Trips must
// degrade to a named unknown with a reason — never a silent zero —
// and the trip-coverage stat must visibly drop below 100%.
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_data_dep(
	.param .u64 micro_data_dep_param_0
)
{
	.reg .pred 	%p<2>;
	.reg .f32 	%f<3>;
	.reg .b64 	%rd<4>;
	.loc	1 3 0

	ld.param.u64 	%rd1, [micro_data_dep_param_0];
	cvta.to.global.u64 	%rd3, %rd1;

$L__BB0_1:
	.loc	1 5 9
	ld.global.f32 	%f1, [%rd3];
	fma.rn.f32 	%f2, %f1, %f1, 0f3F800000;
	st.global.f32 	[%rd3+4], %f2;
	add.s64 	%rd3, %rd3, 8;
	.loc	1 4 5
	setp.gt.f32 	%p1, %f1, 0f00000000;
	@%p1 bra 	$L__BB0_1;

	.loc	1 8 1
	ret;

}
	.file	1 "micro/data_dep.cu"
