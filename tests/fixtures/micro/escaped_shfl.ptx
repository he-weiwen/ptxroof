//
// HAND-WRITTEN: a counter read after a loop whose exit depends on
// %tid.x, minus lane 0's copy of it from `shfl.sync.idx`. Thread t
// leaves with %r3 = t + 1 and lane 0's is 1, so thread t stores at
// param_0 + 4t (ptxas 13.4, sm_89: `SHFL.IDX PT, R3, R0, RZ, 0x1f`,
// `IMAD.IADD R3, R0, 0x1, -R3`, `IMAD.WIDE R2, R3, R2, c[0x0][0x160]`,
// `STG.E [R2.64], R5`). The tracer reads both operands as the loop's
// counter, which cancels before the check that a counter read after
// its loop differs between lanes, so every lane reads param_0.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_escaped_shfl(
	.param .u64 micro_escaped_shfl_param_0
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<6>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_escaped_shfl_param_0];
	mov.u32 	%r2, %tid.x;
	mov.u32 	%r3, 0;
$L__BB0_1:
	add.s32 	%r3, %r3, 1;
	setp.le.u32 	%p1, %r3, %r2;
	@%p1 bra 	$L__BB0_1;
	shfl.sync.idx.b32 	%r4, %r3, 0, 31, -1;
	sub.s32 	%r5, %r3, %r4;
	mul.wide.s32 	%rd2, %r5, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r2;
	ret;
}
