//
// HAND-WRITTEN: loops bounded by a quotient by a parameter (PTX ISA
// §9.7.1.9 `div.u32`), which the tracer does not read:
// - micro_trip_uniform_outer: an inner do-while of (k + %ctaid.x) /
//   param_1 trips, k the counter of the outer loop of 4 trips: the inner
//   count differs between the outer trips;
// - micro_trip_uniform_after_exit: a do-while of q trips, q copied from
//   (k + %ctaid.x) / param_1 in an earlier loop that thread t leaves
//   after t + 1 trips, so each thread has its own q.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_trip_uniform_outer(
	.param .u64 micro_trip_uniform_outer_param_0,
	.param .u32 micro_trip_uniform_outer_param_1
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<7>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_trip_uniform_outer_param_0];
	ld.param.u32 	%r1, [micro_trip_uniform_outer_param_1];
	mov.u32 	%r2, %ctaid.x;
	mov.u32 	%r3, 0;
$L__BB0_1:
	add.s32 	%r4, %r3, %r2;
	div.u32 	%r5, %r4, %r1;
	mov.u32 	%r6, 0;
$L__BB0_2:
	add.s32 	%r6, %r6, 1;
	st.global.u32 	[%rd1], %r6;
	setp.lt.u32 	%p1, %r6, %r5;
	@%p1 bra 	$L__BB0_2;
	add.s32 	%r3, %r3, 1;
	setp.lt.u32 	%p2, %r3, 4;
	@%p2 bra 	$L__BB0_1;
	ret;
}

.visible .entry micro_trip_uniform_after_exit(
	.param .u64 micro_trip_uniform_after_exit_param_0,
	.param .u32 micro_trip_uniform_after_exit_param_1
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<9>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [micro_trip_uniform_after_exit_param_0];
	ld.param.u32 	%r1, [micro_trip_uniform_after_exit_param_1];
	mov.u32 	%r2, %ctaid.x;
	mov.u32 	%r7, %tid.x;
	mov.u32 	%r3, 0;
$L__BB1_1:
	add.s32 	%r4, %r3, %r2;
	div.u32 	%r5, %r4, %r1;
	mov.u32 	%r6, %r5;
	add.s32 	%r3, %r3, 1;
	setp.le.u32 	%p1, %r3, %r7;
	@%p1 bra 	$L__BB1_1;
	mov.u32 	%r8, 0;
$L__BB1_3:
	add.s32 	%r8, %r8, 1;
	st.global.u32 	[%rd1], %r8;
	setp.lt.u32 	%p2, %r8, %r6;
	@%p2 bra 	$L__BB1_3;
	ret;
}
