//
// HAND-WRITTEN: an outer loop of 4 trips, j = 0 to 3, runs an inner loop
// whose counter k counts 1 up while k < j, then stores at param_0 +
// 4·k: k is 1, 1, 2, 3, so the stores touch 12 distinct bytes, not the
// one word of a fixed base. ptxas 13.4 (sm_89) keeps the inner loop
// (`ISETP.GE.AND P1, PT, R3, R2, PT`, `@!P1 BRA 0x90`) and one
// `STG.E [R2.64], R5` in the outer one; an RTX 4090 run sets words 1, 2
// and 3: 12 bytes.
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_inner_exit_counter(
	.param .u64 micro_inner_exit_counter_param_0
)
.reqntid 1, 1, 1
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_inner_exit_counter_param_0];
	mov.u32 	%r1, 0;
$L__BB0_1:
	mov.u32 	%r2, 0;
$L__BB0_2:
	add.s32 	%r2, %r2, 1;
	setp.lt.s32 	%p1, %r2, %r1;
	@%p1 bra 	$L__BB0_2;
	mul.wide.s32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], 1;
	add.s32 	%r1, %r1, 1;
	setp.lt.s32 	%p2, %r1, 4;
	@%p2 bra 	$L__BB0_1;
	ret;
}
