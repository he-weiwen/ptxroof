//
// HAND-WRITTEN: `nanosleep.u32 t` reads t (PTX ISA §9.7.20.2), so %r1
// is still the thread index after it (ptxas 13.4: `S2R R5, SR_TID.X`,
// `NANOSLEEP R5`, then `STG.E [R2.64], R5`).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_nanosleep_reads(
	.param .u64 micro_nanosleep_reads_param_0
)
.reqntid 32, 1, 1
{
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_nanosleep_reads_param_0];
	mov.u32 	%r1, %tid.x;
	nanosleep.u32 	%r1;
	mul.wide.u32 	%rd2, %r1, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	ret;
}
