//
// HAND-WRITTEN: `bar.red.popc.u32 d, a, c` writes d, the CTA's count of
// threads whose c holds (PTX ISA §9.7.14.1): 16 here, so every thread
// stores to word 16, not word 0 (ptxas 13.4: `BAR.RED.POPC.DEFER_BLOCKING
// 0x0, !P0`, `B2R.RESULT R2`, then `IMAD.WIDE.U32 R2, R2, R3,
// c[0x0][0x160]`).
//
.version 8.7
.target sm_89
.address_size 64

.visible .entry micro_barrier_red(
	.param .u64 micro_barrier_red_param_0
)
.reqntid 32, 1, 1
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_barrier_red_param_0];
	mov.u32 	%r1, %tid.x;
	mov.u32 	%r2, 0;
	setp.lt.u32 	%p1, %r1, 16;
	bar.red.popc.u32 	%r2, 0, %p1;
	mul.wide.u32 	%rd2, %r2, 4;
	add.s64 	%rd3, %rd1, %rd2;
	st.global.u32 	[%rd3], %r1;
	ret;
}
