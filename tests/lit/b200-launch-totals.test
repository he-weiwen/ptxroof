# Totals per launch under a record's grid. norope's store runs on 72
# threads of each of its 8192 CTAs, 16 B each: 9437184 B. ds2 rope's
# loads and stores sit in a loop whose latch reads a `min` of %ctaid.y,
# a row range of 16 rows per CTA: per CTA 16640 B per trip, over the
# record's 512 CTAs 136,314,880 B, and the loop's executions agree with
# the B200's.
RUN: %ptxroof analyze %fixtures/b200/rope_kv__deepseek-v3__prefill__sgl_mla_set_norope.set_mla_kv_buffer_kernel_norope.sm_100a.ptx --ncu %fixtures/b200/rope_kv__deepseek-v3__prefill__sgl_mla_set_norope.set_mla_kv_buffer_kernel_norope.sm_100a.ncu.json | FileCheck --check-prefix=NOROPE "%s"
RUN: %ptxroof analyze %fixtures/b200/rope_kv__deepseek-v3__prefill__ll_ds2_rope._rotary_kernel.sm_100a.ptx --ncu %fixtures/b200/rope_kv__deepseek-v3__prefill__ll_ds2_rope._rotary_kernel.sm_100a.ncu.json | FileCheck --check-prefix=DS2 "%s"
NOROPE: totals per CTA [static]:
NOROPE: global bytes: load 2176 B, store 1152 B
NOROPE: totals per launch [static]:
NOROPE: global bytes: load 17825792 B, store 9437184 B
DS2: trips = max(min(16 * %ctaid.y + 16, 8192) - 16 * %ctaid.y, 1)
DS2: totals per CTA [static]:
DS2: global bytes: load 16640 * max(min(16 * %ctaid.y + 16, 8192) - 16 * %ctaid.y, 1) B
DS2: totals per launch [static]:
DS2: global bytes: load 136314880 B, store 135266304 B
DS2: $L__BB0_2{{ +}}confirmed
