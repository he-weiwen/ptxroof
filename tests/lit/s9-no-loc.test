# S9.3 (PLAN.md, acceptance scenarios): no .loc anywhere — the loop is
# named by its header label, $L__BB0_2, its iteration iv[$L__BB0_2], and
# the run still completes with exit 0.
RUN: %ptxroof analyze --annotate %fixtures/micro/no_loc.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}$L__BB0_2: // loop: trips param_1 | under line 27 | exec param_1/thread{{$}}
ANN: {{^}}	ld.global.f32 	%f1, [%rd3]; // global load [4·iv[$L__BB0_2] + param_0] sectors/req ? (block shape unknown: no .reqntid; pass --launch){{$}}
