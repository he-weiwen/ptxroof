# A counter carried through %r2 = %r1 + 1, %r1 = %r2, where %r2 is also
# written before the loop and overwritten before any read: ptxas stores
# at param_0 + 4 to + 16, 4 trips, but the chain is started at %r2's
# 100, so the trip count, the address and the totals follow from 100.
RUN: %ptxroof analyze %fixtures/micro/chain_start.ptx | FileCheck "%s"
CHECK: kernel micro_chain_start
CHECK: trips = -96
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [4 * k[$L__BB0_1] + param_0 + 400]  k[$L__BB0_1]: +4 B/iter
CHECK: totals [static]:
CHECK-NEXT: instructions = -668
