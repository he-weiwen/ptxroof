# A counter carried through %r2 = %r1 + 1, %r1 = %r2, where %r2 is also
# written before the loop and overwritten before any read: ptxas stores
# at param_0 + 4 to + 16, 4 trips, and the recurrence starts from %r1's
# 0, the value entering the loop, not %r2's 100. That write of 100 is
# unused.
RUN: %ptxroof analyze --annotate %fixtures/micro/chain_start.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	mov.u32 	%r2, 100; // unused{{$}}
ANN: {{^}}$L__BB0_1: // loop: trips 4 | global per CTA: requested 16 B, unique 16 B, sectors 128 B | warp * × lane * | exec 4/CTA{{$}}
ANN: {{^}}	st.global.u32 	[%rd3], 0; // global store [4·iv[$L__BB0_1] + param_0 + 4] sectors/req 1 (ideal 1){{$}}
