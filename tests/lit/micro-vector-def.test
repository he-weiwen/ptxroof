# A guard on a register a vector load overwrote: the load is its
# definition, so the store runs on a bound of the threads, not all 64
# as when only the earlier `mov %r3, 0` was seen.
RUN: %ptxroof analyze %fixtures/micro/vector_def.ptx | FileCheck "%s"
CHECK: kernel micro_vector_def
CHECK: st.global.u32     global store 4 B (predicated)  warp: <= 9 sectors (ideal 4)
CHECK: global bytes: load 512 B, store <= 256 B
