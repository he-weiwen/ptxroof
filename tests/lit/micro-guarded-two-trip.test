# LLVM's two-trip loop whose predicate only lanes below 32 set true,
# under a guard: ptxas runs 2 trips for lanes 0-31 and 1 for lanes
# 32-63, storing at param_0 + 8 or + 4. The trip count refuses the
# guarded write, and the store's counter differs by lane.
RUN: %ptxroof analyze %fixtures/micro/guarded_two_trip.ptx | FileCheck "%s"
CHECK: kernel micro_guarded_two_trip
CHECK: trips = unknown: %p3 is written under a guard
CHECK: st.global.u32  global store 4 B    unknown: k[$L__BB0_1] differs between lanes after its loop, whose exit depends on %tid.x
