# %r3 < 32 guards both stores, %r3 written under a guard on the
# parameter n. In the first kernel %r3 is 100 unless n is 0, so no
# thread stores unless n is 0; in the second both writes are %tid.x and
# 32 threads store. A selector's operands are read strictly, a write
# under a guard refused, so in each kernel the store runs on at most the
# CTA's 64 threads: its count, its sectors per request and the CTA's
# global store bytes are bounds.
RUN: %ptxroof analyze --annotate %fixtures/micro/guarded_selector.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry micro_guarded_selector( // block 64×1×1 | per CTA: global store <= 256 B; param load 768 B{{$}}
ANN: {{^}}	@%p2 st.global.u32 	[%rd3], %r2; // exec <= 64/CTA | global store [4·%tid.x + param_0] sectors/req <= 5 (ideal 4){{$}}
ANN: {{^}}.visible .entry micro_guarded_selector_agreeing( // block 64×1×1 | per CTA: global store <= 256 B; param load 768 B{{$}}
ANN: {{^}}	@%p2 st.global.u32 	[%rd3], %r2; // exec <= 64/CTA | global store [4·%tid.x + param_0] sectors/req <= 5 (ideal 4){{$}}
