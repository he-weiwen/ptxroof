# A do-while loop whose latch is false at its first evaluation runs
# once (ptxas, and on an RTX 4090): with no guard before it, its count
# is max(T, 1) per entry, as LLVM's ScalarEvolution counts a rotated
# loop's backedges from max(RHS, Start), so 1 where the latch solves to
# 5 - 10 = -5: each of the CTA's 32 threads runs both 4 B stores once,
# 256 B. With the parameter unbound the second loop reads
# `max(param_1 - 10, 1)`; under the RTX 4090 record, at n = 5, it runs
# once.
RUN: %ptxroof analyze --annotate %fixtures/micro/latch_exits_first.ptx | FileCheck --check-prefix=ANN-FREE "%s"
RUN: %ptxroof analyze --annotate %fixtures/micro/latch_exits_first.ptx --bind 1:n=5 | FileCheck --check-prefix=ANN-BIND "%s"
RUN: %ptxroof analyze --annotate %fixtures/micro/latch_exits_first.ptx --ncu %fixtures/micro/latch_exits_first.ncu.json | FileCheck --check-prefix=ANN-REC "%s"
ANN-BIND: {{^}}.visible .entry micro_latch_exits_first( // block 32×1×1 | param_1 = 5 | per CTA: global store 256 B; param load 256 B{{$}}
ANN-BIND: {{^}}$L__BB0_1: // loop: trips 1 | global per CTA: requested 256 B, unique 8 B, sectors 64 B | warp * × lane * | exec 32/CTA{{$}}
ANN-BIND: {{^}}.visible .entry micro_latch_exits_first_param( // block 32×1×1 | param_1 = 5 | per CTA: global store 256 B; param load 384 B{{$}}
ANN-BIND: {{^}}$L__BB1_1: // loop: trips 1 | global per CTA: requested 256 B, unique 8 B, sectors 64 B | warp * × lane * | exec 32/CTA{{$}}
ANN-FREE: {{^}}$L__BB1_1: // loop: trips max(param_1 - 10, 1) | warp * × lane * | exec (32·max(param_1 - 10, 1))/CTA{{$}}
ANN-REC: {{^}}$L__BB1_1: // loop: trips 1 | global per CTA: requested 256 B, unique 8 B, sectors 64 B | warp * × lane * | exec 32/launch{{$}}
