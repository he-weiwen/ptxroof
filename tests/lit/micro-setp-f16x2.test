# The second output of `setp.lt.f16x2` compares the upper halves, 0 < 0,
# so ptxas never runs the store. A packed comparison is not read: the
# store, predicated on an unknown selector, runs on at most the CTA's 64
# threads, so its count, its sectors per request and the CTA's global
# store bytes are bounds.
RUN: %ptxroof analyze --annotate %fixtures/micro/setp_f16x2.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry micro_setp_f16x2( // block 64×1×1 | per CTA: global store <= 256 B; param load 512 B{{$}}
ANN: {{^}}	@%p2 st.global.u32 	[%rd3], %r1; // exec <= 64/CTA | global store [4·%tid.x + param_0] sectors/req <= 5 (ideal <= 4){{$}}
