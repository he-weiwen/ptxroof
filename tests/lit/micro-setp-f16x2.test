# The second output of `setp.lt.f16x2` compares the upper halves, 0 < 0,
# so ptxas never runs the store. A packed comparison is not read: the
# store is predicated on an unknown selector, a bound.
RUN: %ptxroof analyze %fixtures/micro/setp_f16x2.ptx | FileCheck "%s"
CHECK: kernel micro_setp_f16x2
CHECK: st.global.u32  global store 4 B (predicated)  warp: <= 5 sectors (ideal <= 4)  [4 * %tid.x + param_0]
CHECK: totals per CTA [static]:
CHECK: global bytes: load 0 B, store <= 256 B
