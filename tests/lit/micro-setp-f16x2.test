# Wrong output (PLAN.md): the second output of `setp.lt.f16x2` is read
# as the first's negation. It compares the upper halves, 0 < 0, so
# ptxas never runs the store.
RUN: %ptxroof analyze %fixtures/micro/setp_f16x2.ptx | FileCheck "%s"
CHECK: kernel micro_setp_f16x2
CHECK: st.global.u32  global store 4 B on 64 threads in 2 warps (%tid.x >= 0)
