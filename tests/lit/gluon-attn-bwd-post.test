# Backward postprocess: the fp32 dQ accumulator scaled to bf16, one block
# run once by each of the 128 threads `.reqntid` sets: 64 f32 flops,
# 256 B loaded and 128 B stored per thread, 128 times that per CTA.
RUN: %ptxroof analyze %fixtures/gluon/attn_bwd_post_kernel.sm_89.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry attn_bwd_post_kernel( // block 128×1×1 | pointer params assumed 32 B aligned | per CTA: flops f32 8,192; global load 32,768 B, store 16,384 B; param load 5,120 B{{$}}
ANN: {{^}}$L__func_begin0: // warp * × lane * | exec 128/CTA{{$}}
