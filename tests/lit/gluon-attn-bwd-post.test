# Backward postprocess: the fp32 dQ accumulator scaled to bf16, one block.
RUN: %ptxroof analyze %fixtures/gluon/attn_bwd_post_kernel.sm_89.ptx | FileCheck "%s"
CHECK: kernel attn_bwd_post_kernel
CHECK: block size: 128 threads, 4 warps (128x1x1 from .reqntid)
CHECK: flops = 64  (f32 64)
CHECK: global bytes: load 256 B, store 128 B
CHECK: unknowns: none
