# ptxas runs the first store on the 36 threads with %tid.x mod 16 equal
# to 0 or 8 to 15, %tid.x << 28 wrapping at 2^32: a signed comparison is
# read only when both operands lie in [-2^31, 2^31) on every thread, so
# the store is a bound.
# Wrong output (PLAN.md): an equality `setp` is read as a comparison of
# the traced forms, which do not wrap at 2^32. ptxas runs the second
# store on thread 16.
RUN: %ptxroof analyze %fixtures/micro/setp_wraps.ptx | FileCheck "%s"
CHECK-LABEL: kernel micro_setp_wraps_signed
CHECK: st.global.u32  global store 4 B (predicated)  warp: <= 5 sectors (ideal 4)  [4 * %tid.x + param_0]
CHECK: totals per CTA [static]:
CHECK: global bytes: load 0 B, store <= 256 B
CHECK-LABEL: kernel micro_setp_wraps_eq
CHECK: st.global.u32  global store 4 B on 0 threads in 0 warps (%tid.x == -4294967280)
