# The traced forms do not wrap at 2^32. ptxas runs the first store on
# the 36 threads with %tid.x mod 16 equal to 0 or 8 to 15, %tid.x << 28
# wrapping: a signed comparison is read only when both operands lie in
# [-2^31, 2^31) on every thread. It runs the second on thread 16, where
# %tid.x + 0xFFFFFFF0 wraps to 0: an equality is read only when the
# operands' difference lies in (-2^32, 2^32). Both stores are bounds.
RUN: %ptxroof analyze %fixtures/micro/setp_wraps.ptx | FileCheck "%s"
CHECK-LABEL: kernel micro_setp_wraps_signed
CHECK: st.global.u32  global store 4 B (predicated)  warp: <= 5 sectors (ideal 4)  [4 * %tid.x + param_0]
CHECK: totals per CTA [static]:
CHECK: global bytes: load 0 B, store <= 256 B
CHECK-LABEL: kernel micro_setp_wraps_eq
CHECK: st.global.u32  global store 4 B (predicated)  warp: <= 5 sectors (ideal 4)  [4 * %tid.x + param_0]
CHECK: totals per CTA [static]:
CHECK: global bytes: load 0 B, store <= 256 B
