# Wrong output (PLAN.md): a signed or an equality `setp` is read as a
# comparison of the traced forms, which do not wrap at 2^32. ptxas runs
# the first store on the 36 threads with %tid.x mod 16 equal to 0 or 8
# to 15, and the second on thread 16.
RUN: %ptxroof analyze %fixtures/micro/setp_wraps.ptx | FileCheck "%s"
CHECK-LABEL: kernel micro_setp_wraps_signed
CHECK: st.global.u32  global store 4 B on 1 thread in 1 warp (268435456 * %tid.x < 268435456)
CHECK-LABEL: kernel micro_setp_wraps_eq
CHECK: st.global.u32  global store 4 B on 0 threads in 0 warps (%tid.x == -4294967280)
