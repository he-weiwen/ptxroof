# A floor and a mod of a loop counter: ptxas stores to three words of a,
# 12 B, and two of b, 8 B; the footprint reads each address at every
# trip, and its reuse note says it varies.
RUN: %ptxroof analyze %fixtures/micro/counter_floor_mod.ptx | FileCheck "%s"
CHECK: kernel micro_counter_floor_mod
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [4 * ⌊k[$L__BB0_1]/2⌋ + param_0]      k[$L__BB0_1]: varies
CHECK-NEXT: global bytes per CTA over the loop's own blocks: requested 16 B, unique 12 B, in sectors 128 B
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [4 * (k[$L__BB0_3] mod 2) + param_1]  k[$L__BB0_3]: varies
CHECK-NEXT: global bytes per CTA over the loop's own blocks: requested 16 B, unique 8 B, in sectors 128 B
