# S10.1 (PLAN.md, acceptance scenarios): is my tensor-core work visible, and only the
# work? Two loop-free kernels whose counts are hand-checkable: one
# wmma m16n16k16 product = 2*16^3 / 32 lanes = 256 tensor flops per
# lane, one mma.sync m16n8k16 = 2*16*8*16 / 32 = 128. The cuda-core
# table must stay at 0: v1 credited every wmma.load with 8192 phantom
# flops, and this is where that regression would show.
RUN: %ptxroof analyze %fixtures/mma_demo/mma_demo.sm_80.ptx --json | %check-report "%s"
{
  "kernels": [
    {
      "name": "_Z18gemm_wmma_16x16x16PK6__halfS1_Pf",
      "instruction_classes": {"unknown": 0, "unparsed": 0},
      "totals": {
        "flops": {"total": {"expr": "0", "at_most": false}},
        "tensor_flops": {
          "total": {"expr": "256", "at_most": false},
          "f16": {"expr": "256", "at_most": false}
        },
        "bytes": {"global": {"load": {"expr": "32", "at_most": false},
                             "store": {"expr": "32", "at_most": false}}},
        "ai_global": {"value": 4.0, "bound": "exact"}
      },
      "unknowns": []
    },
    {
      "name": "_Z16gemm_mma_16x8x16PK6__halfS1_Pf",
      "instruction_classes": {"unknown": 0, "unparsed": 0},
      "totals": {
        "flops": {"total": {"expr": "0", "at_most": false}},
        "tensor_flops": {
          "total": {"expr": "128", "at_most": false},
          "f16": {"expr": "128", "at_most": false}
        },
        "bytes": {"global": {"load": {"expr": "24", "at_most": false},
                             "store": {"expr": "16", "at_most": false}}},
        "ai_global": {"value": 3.2, "bound": "exact"}
      },
      "unknowns": []
    }
  ],
  "coverage": {"loop_trips_resolved": {"num": 0, "den": 0}, "instructions_classified": {"num": 49, "den": 49}}
}
