# The loop's counter, iv + 1, leaves the loop unequal between lanes, so
# the address is unknown, unless a binding removes the counter from it:
# with stride 0 the store is at param_0, one sector per warp request.
RUN: %ptxroof analyze %fixtures/micro/exit_pred_stride.ptx | FileCheck --check-prefix=ANN-FREE "%s"
RUN: %ptxroof analyze %fixtures/micro/exit_pred_stride.ptx --bind 1:stride=0 | FileCheck --check-prefix=ANN-ZERO "%s"
ANN-FREE: {{^}}	st.global.u32 [%rd3], %r1; // global store addr ? ((iv[$L__BB0_1] + 1) differs between lanes after its loop, whose exit depends on %tid.x){{$}}
ANN-ZERO: {{^}}	st.global.u32 [%rd3], %r1; // global store [param_0] sectors/req 1 (ideal 1){{$}}
