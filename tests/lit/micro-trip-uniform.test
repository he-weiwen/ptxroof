# A count in a value the tracer does not read, the same for every thread,
# is that value as a symbol only where it is one value at every trip of
# every entry of the loop: not where an outer loop defines it (it read
# max(uniform(%r5@31), 1) per entry, where the inner count changes with
# the outer counter), nor where threads left the loop defining it at
# different trips (max(uniform(%r5@61), 1), where each thread has its
# own).
RUN: %ptxroof analyze %fixtures/micro/trip_uniform.ptx | FileCheck "%s"
CHECK-LABEL: kernel micro_trip_uniform_outer
CHECK: trips = 4
CHECK: trips = unknown: uniform(%r5@31) is defined in an enclosing loop: div by a non-constant divisor
CHECK-LABEL: kernel micro_trip_uniform_after_exit
CHECK: trips = unknown: latch condition depends on special register %tid.x
CHECK: trips = unknown: uniform(%r5@61) differs between lanes: depends on %tid.x
