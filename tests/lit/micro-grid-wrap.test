# 2^24·%ctaid.x in a mul.lo.u32 keeps its low 32 bits, so from CTA 256
# on it wraps. With no grid, %ctaid is taken not to wrap (PLAN) and the
# `.entry` line names no grid; a grid of 256 CTAs keeps the product
# below 2^32 and the address is read; one of 257 does not, and the
# product, the same for every thread of a CTA, is read as a uniform
# variable. A grid of 0 CTAs is refused.
RUN: %ptxroof analyze %fixtures/micro/grid_wrap.ptx | FileCheck --check-prefix=ANN-FREE "%s"
RUN: %ptxroof analyze %fixtures/micro/grid_wrap.ptx --grid 256 | FileCheck --check-prefix=ANN-FITS "%s"
RUN: %ptxroof analyze %fixtures/micro/grid_wrap.ptx --grid 257,1,1 | FileCheck --check-prefix=ANN-WRAPS "%s"
RUN: not %ptxroof analyze %fixtures/micro/grid_wrap.ptx --grid 0 2>&1 | FileCheck --check-prefix=ANN-ZERO "%s"
ANN-FREE: {{^}}.visible .entry micro_grid_wrap( // block 32×1×1 | pointer params assumed 32 B aligned | per CTA: global store 128 B; param load 256 B{{$}}
ANN-FREE: {{^}}	st.global.u32 	[%rd3], %r2; // global store [4·%tid.x + 67108864·%ctaid.x + param_0] sectors/req 4 (ideal 4){{$}}
ANN-FITS: {{^}}.visible .entry micro_grid_wrap( // grid 256×1×1 | block 32×1×1 | pointer params assumed 32 B aligned | per launch: global store 32,768 B; param load 65,536 B{{$}}
ANN-FITS: {{^}}	st.global.u32 	[%rd3], %r2; // global store [4·%tid.x + 67108864·%ctaid.x + param_0] sectors/req 4 (ideal 4){{$}}
ANN-WRAPS: {{^}}.visible .entry micro_grid_wrap( // grid 257×1×1 | block 32×1×1 | pointer params assumed 32 B aligned | per launch: global store 32,896 B; param load 65,792 B{{$}}
ANN-WRAPS: {{^}}	st.global.u32 	[%rd3], %r2; // global store [4·%tid.x + 4·uniform(%r3@25) + param_0] sectors/req 4–5 (ideal 4){{$}}
ANN-ZERO: {{^}}ptxroof: --grid: every dimension is at least 1{{$}}
