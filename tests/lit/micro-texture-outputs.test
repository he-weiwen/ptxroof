# `tex` with `d|p` writes the elements of d as well as p, so the
# address through %r1 after it is not 4 * %tid.x + param_0 but unknown,
# and the store it guards runs on at most the CTA's 32 threads.
RUN: %ptxroof analyze --annotate %fixtures/micro/texture_outputs.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	@%p1 st.global.u32 	[%rd3], %r2; // exec <= 32/CTA | global store addr ? (value defined by unsupported instruction `tex`){{$}}
