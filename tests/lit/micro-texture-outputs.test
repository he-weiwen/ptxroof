# `tex` with `d|p` writes the elements of d as well as p, so the
# address through %r1 after it is not 4 * %tid.x + param_0.
RUN: %ptxroof analyze %fixtures/micro/texture_outputs.ptx | FileCheck "%s"
CHECK: kernel micro_texture_outputs
CHECK: st.global.u32  global store 4 B (predicated) {{ +}}unknown: value defined by unsupported instruction `tex`
