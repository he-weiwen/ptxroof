# `setp.lt.f32` compares floats. ptxas runs the first store on threads
# 16 to 47 (the bits of %tid.x - 16 are a NaN below 16) and the second
# on none (2^24 + %tid.x and 2^24 + 1 both round to at least 2^24). A
# floating-point comparison is not read, so in each kernel the store
# runs on at most the CTA's 64 threads: its count, its sectors per
# request and the CTA's global store bytes are bounds.
RUN: %ptxroof analyze --annotate %fixtures/micro/setp_float.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry micro_setp_float_bits( // block 64×1×1 | per CTA: global store <= 256 B; param load 512 B{{$}}
ANN: {{^}}	@%p1 st.global.u32 	[%rd3], %r1; // exec <= 64/CTA | global store [4·%tid.x + param_0] sectors/req <= 5 (ideal <= 4){{$}}
ANN: {{^}}.visible .entry micro_setp_float_cvt( // block 64×1×1 | per CTA: global store <= 256 B; param load 512 B{{$}}
ANN: {{^}}	@%p1 st.global.u32 	[%rd3], %r1; // exec <= 64/CTA | global store [4·%tid.x + param_0] sectors/req <= 5 (ideal <= 4){{$}}
