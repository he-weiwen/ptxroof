# Wrong output (PLAN.md): `setp.lt.f32` is read as an integer comparison
# of the traced values. ptxas runs the first store on threads 16 to 47
# (the bits of %tid.x - 16 are a NaN below 16) and the second on none
# (2^24 + %tid.x and 2^24 + 1 both round to at least 2^24).
RUN: %ptxroof analyze %fixtures/micro/setp_float.ptx | FileCheck "%s"
CHECK-LABEL: kernel micro_setp_float_bits
CHECK: st.global.u32  global store 4 B on 48 threads in 2 warps (%tid.x < 48)
CHECK-LABEL: kernel micro_setp_float_cvt
CHECK: st.global.u32  global store 4 B on 1 thread in 1 warp (%tid.x < 1)
