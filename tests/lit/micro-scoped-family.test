# The block's `%r<2>` declares a %r1 of its own, so the kernel's %r1
# is still 7 after it: every thread stores to word 7.
RUN: %ptxroof analyze %fixtures/micro/scoped_family.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [param_0 + 28] sectors/req 1 (ideal 1){{$}}
