# The block's `%r<2>` declares a %r1 of its own, so the kernel's %r1
# is still 7 after it: every thread stores to word 7.
RUN: %ptxroof analyze %fixtures/micro/scoped_family.ptx | FileCheck "%s"
CHECK: kernel micro_scoped_family
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [param_0 + 28]
