# One address written as m + n and as n + m is one base: the loop's two
# stores touch 128 distinct bytes. With the sums' terms in the order
# written the two read as different bases, `unique 128–256 B`.
RUN: %ptxroof analyze %fixtures/micro/commuted_sum.ptx | FileCheck "%s"
CHECK: st.global.u32 {{.*}} [4 * %tid.x + param_0 + 4 * param_1 + 4 * param_2]
CHECK: st.global.u32 {{.*}} [4 * %tid.x + param_0 + 4 * param_1 + 4 * param_2]
CHECK: requested 256 B, unique 128 B,
