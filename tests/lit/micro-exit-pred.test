# A predicate set in a loop whose exit depends on %tid.x and read after
# it: each lane keeps the value of its own last iteration, so the
# store's lanes are a bound. Nsight Compute: 17 of 64 threads store.
# An address through the loop's counter differs between lanes too.
RUN: %ptxroof analyze %fixtures/micro/exit_pred.ptx | FileCheck "%s"
CHECK: kernel micro_exit_pred_xor
CHECK: st.global.u32  global store 4 B (predicated)  warp: <= 5 sectors (ideal <= 4)
CHECK: kernel micro_exit_pred_add
CHECK: st.global.u32  global store 4 B (predicated)  warp: <= 5 sectors (ideal <= 4)
CHECK: kernel micro_exit_pred_addr
CHECK: st.global.u32  global store 4 B    unknown: k[$L__BB2_1] differs between lanes after its loop, whose exit depends on %tid.x
