# A predicate set in a loop whose exit depends on %tid.x and read after
# it: each lane keeps the value of its own last iteration, so the
# store's lanes are a bound, at most 64 threads and 256 B per CTA, and
# so are its sectors and their ideal. Nsight Compute: 17 of 64 threads
# store. An address through the loop's counter differs between lanes
# too, so it is unknown.
RUN: %ptxroof analyze %fixtures/micro/exit_pred.ptx | FileCheck "%s"
CHECK: {{^}}.visible .entry micro_exit_pred_xor( // block 64×1×1 | pointer params assumed 32 B aligned | per CTA: global store <= 256 B; param load 512 B{{$}}
CHECK: {{^}}	@%p3 st.global.u32 [%rd3], %r1; // <= warp * × lane * | exec <= 64/CTA | global store [4·%tid.x + param_0] sectors/req <= 4 (ideal <= 4){{$}}
CHECK: {{^}}.visible .entry micro_exit_pred_add( // block 64×1×1 | pointer params assumed 32 B aligned | per CTA: global store <= 256 B; param load 512 B{{$}}
CHECK: {{^}}	@%p3 st.global.u32 [%rd3], %r1; // <= warp * × lane * | exec <= 64/CTA | global store [4·%tid.x + param_0] sectors/req <= 4 (ideal <= 4){{$}}
CHECK: {{^}}.visible .entry micro_exit_pred_addr( // block 64×1×1 | per CTA: global store 256 B; param load 512 B{{$}}
CHECK: {{^}}	st.global.u32 [%rd3], %r1; // global store addr ? ((iv[$L__BB2_1] + 1) differs between lanes after its loop, whose exit depends on %tid.x){{$}}
