# `call (%r2), zero, (%r1)` writes %r2, so the address through it is not
# the thread index's; it was read as `4 * %tid.x + param_0` with the
# call unparsed, where ptxas stores to param_0.
RUN: %ptxroof analyze %fixtures/micro/call_returns.ptx | FileCheck "%s"
CHECK: kernel micro_call_returns
CHECK: st.global.u32  global store 4 B {{ +}}unknown: value defined by unsupported instruction `call`
CHECK-NOT: unparsed
