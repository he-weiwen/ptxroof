# Wrong output (PLAN.md): `%r1.h0` is read as a register of its own,
# so %r1 is still the thread index after the `vadd` that writes it.
# ptxas stores to param_0 from all 32 threads.
RUN: %ptxroof analyze %fixtures/micro/video_selector.ptx | FileCheck "%s"
CHECK: kernel micro_video_selector
CHECK: st.global.u32  global store 4 B  warp: 4–5 sectors (ideal 4)    [4 * %tid.x + param_0]
