# Wrong output (PLAN.md): the latch `setp.lt.ftz.f32` is read as an
# integer comparison of the counter, k < 10. Its operands are subnormal
# and flushed to zero, so ptxas's loop runs once.
RUN: %ptxroof analyze %fixtures/micro/latch_float.ptx | FileCheck "%s"
CHECK: kernel micro_latch_float
CHECK: loop $L__BB0_1 ($L__BB0_1)
CHECK-NEXT: trips = 10
CHECK: totals [static]:
CHECK: global bytes: load 0 B, store 40 B
