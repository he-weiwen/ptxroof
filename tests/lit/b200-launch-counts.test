# Counts over the launch, summed over the record's CTAs. In
# _chunk_scan_fwd_tma (grid 2x32x80, 384 threads), the load on line 184
# runs on the 256 threads of warps 0 to 7 in the CTAs whose %ctaid.y is
# not 0, 31 of every 32: 2·31·80·256 = 1269760 times.
RUN: %ptxroof analyze --annotate %fixtures/b200/scan_tma_ws_best._chunk_scan_fwd_tma.sm_100a.ptx --ncu %fixtures/b200/scan_tma_ws_best._chunk_scan_fwd_tma.sm_100a.ncu.json | FileCheck --check-prefix=ANN "%s"
RUN: %ptxroof analyze %fixtures/b200/scan_tma_ws_best._chunk_scan_fwd_tma.sm_100a.ptx --ncu %fixtures/b200/scan_tma_ws_best._chunk_scan_fwd_tma.sm_100a.ncu.json | FileCheck "%s"
ANN: {{^}}.visible .entry _chunk_scan_fwd_tma( // grid 2×32×80 | block 384×1×1 | param_1 = 8192, param_2 = 256, param_6 = 8192, param_7 = 5120, param_11 = 8192, param_12 = 5120, param_16 = 8192, param_17 = 128, param_21 = 163840, param_22 = 128, param_26 = 8192, param_27 = 5120, param_34 = 256, param_35 = 64, param_36 = 8192, param_37 = 80, param_38 = 256, param_39 = 8192, param_40 = 256, param_41 = 8192 | shared memory 0 B/CTA + dynamic | per launch: flops f32 <= 630,456,320 + ?; sfu flops f32 <= 127,139,840 + ?; tensor, atomic flops ?; global load ? B, store ? B; shared load ? B, store ? B; param load 89,128,960 B{{$}}
ANN: {{^}}	@%p17 ld.global.b32 { %r93 }, [ %rd62 + 0 ]; // exec 1,269,760/launch | global load [1024·%ctaid.y + param_32 - 4] sectors/req 1 (ideal 1){{$}}
CHECK: global load 4 B on <= 256 threads in <= 8 warps (⌊%tid.x/32⌋ < 8 and %ctaid.y != 0)
