# mul.lo.s32 of 2^30 and 4 wraps to 0, and ptxas stores at param_0. The
# product's range, both factors constant, leaves 32 bits, so it is no
# affine form; every thread computes the same value, so the address is
# read with it as a uniform variable, one sector per warp, rather than
# param_0 + 2^34.
RUN: %ptxroof analyze %fixtures/micro/mul_wrap.ptx | FileCheck "%s"
CHECK: kernel micro_mul_wrap
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [4 * uniform(%r2@24) + param_0]
