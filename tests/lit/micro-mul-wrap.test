# mul.lo.s32 of 2^30 and 4 wraps to 0, and ptxas stores at param_0, but
# the tracer does not wrap the product to 32 bits: param_0 + 2^34.
RUN: %ptxroof analyze %fixtures/micro/mul_wrap.ptx | FileCheck "%s"
CHECK: kernel micro_mul_wrap
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [param_0 + 17179869184]
