# mul.lo.s32 of 2^30 and 4 wraps to 0, and ptxas stores at param_0. The
# product is 2^32 as traced; the address reads its `.s32` value, 0,
# rather than param_0 + 2^34.
RUN: %ptxroof analyze %fixtures/micro/mul_wrap.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], 0; // global store [param_0] sectors/req 1 (ideal 1){{$}}
