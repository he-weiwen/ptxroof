# mul.lo.s32 of 2^30 and 4 wraps to 0, and ptxas stores at param_0. The
# product's range, both factors constant, leaves 32 bits, so the address
# is unknown rather than param_0 + 2^34.
RUN: %ptxroof analyze %fixtures/micro/mul_wrap.ptx | FileCheck "%s"
CHECK: kernel micro_mul_wrap
CHECK: st.global.u32  global store 4 B    unknown: `mul.lo.s32` leaves 32 bits
