# The float product of the two subnormals underflows to 0, so every
# thread stores at param_0. A `mul.f32` is not read as an integer
# product: the store's address is unknown.
RUN: %ptxroof analyze %fixtures/micro/float_mul.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (`mul.f32` is floating-point arithmetic){{$}}
