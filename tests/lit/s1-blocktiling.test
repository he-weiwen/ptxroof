# S1 (PLAN.md, acceptance scenarios): is this kernel's design point what
# I computed on paper? k5 at BM=64 BN=64 BK=8 TM=8 TN=8: the tile loop
# runs ⌈param_2/8⌉ trips, each 1024 f32 FLOPs over 32 requested global
# bytes per thread; its dot loop runs 8 trips per tile.
# Shape-independent, so no --bind.
RUN: %ptxroof analyze %fixtures/k5/k5.sm_80.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry _Z20hgemm_2d_blocktilingILi64ELi64ELi8ELi8ELi8EEviiifPK6__halfS2_fPS0_( // shared memory 2,048 B/CTA | per thread: flops f32 (1024·⌈param_2/8⌉ + 192); global load (32·⌈param_2/8⌉ + 128) B, store 128 B; shared load 256·⌈param_2/8⌉ B, store 32·⌈param_2/8⌉ B; param load 40 B{{$}}
ANN: {{^}}$L__BB0_2: // loop: trips ⌈param_2/8⌉ | under line 64 | exec ⌈param_2/8⌉/thread{{$}}
ANN: {{^}}$L__BB0_3: // loop: trips 8 | under line 64 | exec 8·⌈param_2/8⌉/thread{{$}}
