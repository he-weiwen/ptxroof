# The cross-entropy chunk at nanochat's vocabulary, 512 threads, its
# shared memory set at launch: two eight-trip loops, fully counted, each
# CTA's global bytes over them 65,536 B and 131,072 B requested, all
# distinct. The target column each CTA gathers (line 45) is one value
# for the CTA: its index is loaded through param_1, which the kernel
# does not write, and its load requests 1 sector. The `atom` runs on one
# thread of each CTA, `%tid.x == 0`.
RUN: %ptxroof analyze --annotate %fixtures/gluon/ce_chunk_kernel.sm_89.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry ce_chunk_kernel( // block 512×1×1 | shared memory 0 B/CTA + dynamic | per CTA: flops bf16 32,768 + f32 <= 1,026,560; sfu flops f32 198,144; global load 138,244 B, store 65,544 B; shared load 4,096 B, store 4,096 B; param load 26,624 B{{$}}
ANN: {{^}}	ld.global.b64 { %rd7 }, [ %rd8 + 0 ]; // global load [8·%ctaid.x + param_1] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	ld.global.b16 { %rs1 }, [ %rd10 + 0 ]; // global load [65536·%ctaid.x + 2·uniform(%rd14@86) + param_0] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}$L__BB0_1:                              // =>This Inner Loop Header: Depth=1 // loop: trips 8 | global per CTA: requested 65,536 B, unique 65,536 B, sectors 65,536–69,632 B | warp * × lane * | exec 4,096/CTA{{$}}
ANN: {{^}}$L__BB0_5:                              // =>This Inner Loop Header: Depth=1 // loop: trips 8 | global per CTA: requested 131,072 B, unique 131,072 B, sectors 131,072–139,264 B | warp * × lane * | exec 4,096/CTA{{$}}
ANN: {{^}}	@%p33 atom.global.gpu.acq_rel.max.s32 %r408, [ %rd30 + 0 ], %r409; // warp 0 × lane 0 | exec 1/CTA | global load+store [param_4] sectors/req 1 (ideal 1){{$}}
