# `ld.param::entry` reads a kernel parameter as `ld.param` does: the
# store's address is the parameter's, and bound to 48 its guard runs the
# store on 48 threads, as in micro-guard-bound-param.test.
RUN: %ptxroof analyze %fixtures/micro/param_entry.ptx --bind 1:n=48 | FileCheck --check-prefix=BOUND "%s"
BOUND: {{^}}.visible .entry micro_param_entry( // block 64×1×1 | param_1 = 48 | pointer params assumed 32 B aligned | per CTA: global store 192 B; param load 768 B{{$}}
BOUND: {{^}}	@%p1 st.global.u32 	[%rd3], %r2; // warp 0 × lane * ∪ warp 1 × lane 0-15 | exec 48/CTA | global store [4·%tid.x + param_0] sectors/req 2–4 (ideal 2–4){{$}}
