# `tcgen05.ld.red` writes redval, %r1, so the first address is not
# 4 * %tid.x + param_0; `tcgen05.dealloc` reads taddr, so the second
# address is the parameter's.
RUN: %ptxroof analyze %fixtures/micro/tcgen05_outputs.ptx | FileCheck "%s"
CHECK: kernel micro_tcgen05_outputs
CHECK: st.global.u32  global store 4 B {{ +}}unknown: value defined by unsupported instruction `tcgen05`
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [param_0 + 4 * param_1]
