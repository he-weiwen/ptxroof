# `tcgen05.ld.red` writes redval, %r1, so the first store's address is
# not 4 * %tid.x + param_0 but unknown; `tcgen05.dealloc` reads taddr,
# so the second store's address is the parameter's.
RUN: %ptxroof analyze --annotate %fixtures/micro/tcgen05_outputs.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], %r2; // global store addr ? (value defined by unsupported instruction `tcgen05`){{$}}
ANN: {{^}}	st.global.u32 	[%rd5], %r3; // global store [param_0 + 4·param_1] sectors/req 1 (ideal 1){{$}}
