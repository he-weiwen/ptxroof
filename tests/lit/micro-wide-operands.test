# A `.wide` multiply reads its operands as its type (PTX ISA §9.7.1.3):
# an operand whose range the type does not hold is refused, %tid.x − 256
# as u32, %tid.x + 0x7fffff00 as s32 and a 16-bit −1 as u16; as s32
# %tid.x − 256 is read.
RUN: %ptxroof analyze %fixtures/micro/wide_operands.ptx | FileCheck "%s"
CHECK: kernel micro_wide_unsigned
CHECK: st.global.u32  global store 4 B
CHECK-SAME: unknown: `mul.wide.u32` reads a value its type does not hold
CHECK: kernel micro_wide_signed
CHECK: st.global.u32  global store 4 B  warp: 4–5 sectors (ideal 4)
CHECK-SAME: [4 * %tid.x + param_0 - 1024]
CHECK: kernel micro_wide_high
CHECK: st.global.u32  global store 4 B
CHECK-SAME: unknown: `mul.wide.s32` reads a value its type does not hold
CHECK: kernel micro_wide_u16
CHECK: st.global.u32  global store 4 B
CHECK-SAME: unknown: `mul.wide.u16` reads a value its type does not hold
