# A `.wide` multiply reads its operands as its type (PTX ISA §9.7.1.3):
# an operand whose range the type does not hold is refused, the store's
# address unknown, for %tid.x − 256 as u32, %tid.x + 0x7fffff00 as s32
# and a 16-bit −1 as u16; as s32 %tid.x − 256 is read.
RUN: %ptxroof analyze %fixtures/micro/wide_operands.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (`mul.wide.u32` reads a value its type does not hold){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [4·%tid.x + param_0 - 1024] sectors/req 4 (ideal 4){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (`mul.wide.s32` reads a value its type does not hold){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (`mul.wide.u16` reads a value its type does not hold){{$}}
