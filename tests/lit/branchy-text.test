# Block table margins on an in-loop conditional (PR 31): the header
# both opens the skip over the guarded block and receives the back
# edge from the latch, so the two edges share the header row.
RUN: %ptxroof analyze %fixtures/micro/branchy.ptx | FileCheck "%s"
CHECK: kernel micro_branchy
CHECK: blocks (program order; loops are named by their header block):
CHECK: /----  <block 0>  branchy.cu:3         5  $L__BB0_5, <block 1>
CHECK: |      <block 1>  branchy.cu:3         2  $L__BB0_2
CHECK: |//->  $L__BB0_2  branchy.cu:5-6       4  $L__BB0_4, <block 3>  branchy.cu:4 (header)
CHECK: |||    <block 3>  branchy.cu:7         1  $L__BB0_4             branchy.cu:4
CHECK: |\\->  $L__BB0_4  branchy.cu:4-8       5  $L__BB0_2, $L__BB0_5  branchy.cu:4 (latch)
CHECK: \--->  $L__BB0_5  branchy.cu:10        1  (end)
CHECK: loop branchy.cu:4 ($L__BB0_2)
