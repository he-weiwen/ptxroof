# A store guarded on %tid.x < n: ptxas stores on the threads below n.
# Unbound, n leaves the guard an unknown selector, a bound of all 64
# threads, 256 B per CTA; bound to 48, the comparison reads under the
# binding and the store runs on 48 threads in 2 warps, all of warp 0 and
# lanes 0-15 of warp 1, 192 B per CTA.
RUN: %ptxroof analyze %fixtures/micro/guard_bound_param.ptx | FileCheck --check-prefix=FREE "%s"
RUN: %ptxroof analyze %fixtures/micro/guard_bound_param.ptx --bind 1:n=48 | FileCheck --check-prefix=BOUND "%s"
FREE: {{^}}.visible .entry micro_guard_bound_param( // block 64×1×1 | pointer params assumed 32 B aligned | per CTA: global store <= 256 B; param load 768 B{{$}}
FREE: {{^}}	@%p1 st.global.u32 	[%rd3], %r2; // <= warp * × lane * | exec <= 64/CTA | global store [4·%tid.x + param_0] sectors/req <= 4 (ideal <= 4){{$}}
BOUND: {{^}}.visible .entry micro_guard_bound_param( // block 64×1×1 | param_1 = 48 | pointer params assumed 32 B aligned | per CTA: global store 192 B; param load 768 B{{$}}
BOUND: {{^}}	@%p1 st.global.u32 	[%rd3], %r2; // warp 0 × lane * ∪ warp 1 × lane 0-15 | exec 48/CTA | global store [4·%tid.x + param_0] sectors/req 2–4 (ideal 2–4){{$}}
