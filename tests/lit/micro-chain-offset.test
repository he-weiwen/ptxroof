# A counter carried through two registers, %r2 = %r1 + 2, %r1 = %r2 - 1:
# ptxas stores at param_0 + 8 to + 20, 4·iv + 8 on trip iv + 1, and %r2
# is read from %r1's recurrence plus 2, with the offset.
RUN: %ptxroof analyze --annotate %fixtures/micro/chain_offset.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], 0; // global store [4·iv[$L__BB0_1] + param_0 + 8] sectors/req 1 (ideal 1){{$}}
