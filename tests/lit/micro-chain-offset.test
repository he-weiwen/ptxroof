# A counter carried through two registers, %r2 = %r1 + 2, %r1 = %r2 - 1:
# ptxas stores at param_0 + 8 to + 20, 4k + 4 on trip k, and %r2 is read
# from %r1's recurrence plus 2, with the offset.
RUN: %ptxroof analyze %fixtures/micro/chain_offset.ptx | FileCheck "%s"
CHECK: kernel micro_chain_offset
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [4 * k[$L__BB0_1] + param_0 + 4]  k[$L__BB0_1]: +4 B/iter
