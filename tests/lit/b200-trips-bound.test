# Under their records the K loops' bounds are constants, read where the
# latch is traced with the record's parameters: w8a8's
# max(⌈K/128⌉, 2) − 1 at K = 7168 is 55 trips, scaled_mm's at K = 8192
# is 63. w8a8's loop blocks then agree with Nsight Compute: 131
# single-opcode lines measure 259,522,560 = 55 trips × 36,864 CTAs × 128
# threads, its loop header's executions.
RUN: %ptxroof analyze %fixtures/b200/gemm__deepseek-v3__prefill__sgl_w8a8_block_fp8.mlp_gate_up._w8a8_block_fp8_matmul.sm_100a.ptx --ncu %fixtures/b200/gemm__deepseek-v3__prefill__sgl_w8a8_block_fp8.mlp_gate_up._w8a8_block_fp8_matmul.sm_100a.ncu.json | FileCheck --check-prefix=W8A8 "%s"
RUN: %ptxroof analyze --annotate %fixtures/b200/gemm__deepseek-v3__prefill__sgl_w8a8_block_fp8.mlp_gate_up._w8a8_block_fp8_matmul.sm_100a.ptx --ncu %fixtures/b200/gemm__deepseek-v3__prefill__sgl_w8a8_block_fp8.mlp_gate_up._w8a8_block_fp8_matmul.sm_100a.ncu.json | FileCheck --check-prefix=ANNW8A8 "%s"
RUN: %ptxroof analyze --annotate %fixtures/b200/gemm__llama3-70b__prefill__sgl_scaled_mm.gate_up.scaled_mm_kernel.sm_100a.ptx --ncu %fixtures/b200/gemm__llama3-70b__prefill__sgl_scaled_mm.gate_up.scaled_mm_kernel.sm_100a.ncu.json | FileCheck --check-prefix=SCALED "%s"
W8A8: $L__BB0_6        confirmed
W8A8: <block 7>        confirmed
ANNW8A8: {{^}}$L__BB0_4:                              // =>This Inner Loop Header: Depth=1 // loop: trips 55 | global per CTA: requested 1,358,848 B, unique ? | warp * × lane * | exec 259,522,560/launch{{$}}
SCALED: {{^}}$L__BB0_4:                              // =>This Inner Loop Header: Depth=1 // loop: trips 63 | global per CTA: requested 1,998,848 B, unique <= 2,064,384 B, sectors <= 2,064,384–2,580,480 B | warp * × lane * | exec 231,211,008/launch{{$}}
