# The annotated PTX of micro/guarded_exit_bound.ptx: why the store's
# address is not known names the loop's counter k as iv + 1, iv its
# iteration from 0, by the loop's header.
RUN: %ptxroof analyze %fixtures/micro/guarded_exit_bound.ptx | FileCheck "%s"
CHECK: {{^}}$L__BB0_1: // loop: trips ? (%r2 is written under a guard) | warp * × lane * | exec ?{{$}}
CHECK: {{^}}	st.global.u32 	[%rd3], 0; // global store addr ? ((iv[$L__BB0_1] + 1) differs between lanes after its loop, whose exit depends on %tid.x){{$}}
