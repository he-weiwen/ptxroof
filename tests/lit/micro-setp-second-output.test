# A `setp`'s second output, the complement of its comparison, is read
# where its first is: a latch on it counts 4 trips, as an RTX 4090 run
# stores 4; a predicate copied by `mov.pred` is the threads its source
# selects, lanes 0 to 3, as the run's stores are.
RUN: %ptxroof analyze %fixtures/micro/setp_second_output.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}$L__BB0_1: // loop: trips 4 | warp * × lane * | exec 4/CTA{{$}}
ANN: {{^}}	@%p2 st.global.u32 	[%rd3], 1; // warp * × lane 0-3 | exec 4/CTA | global store [4·%tid.x + param_0] sectors/req 1 (ideal 1){{$}}
