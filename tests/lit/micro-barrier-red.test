# `bar.red.popc` writes its first operand: the address through it is
# not the value before the reduction, `[param_0]`.
RUN: %ptxroof analyze %fixtures/micro/barrier_red.ptx | FileCheck "%s"
CHECK: kernel micro_barrier_red
CHECK: st.global.u32  global store 4 B    unknown: depends on special register %tid.x, behind `bar.red.popc.u32`
