# A `.shared` variable without an array size, at module scope and in
# the kernel, prints back as a scalar and reserves its type's size: the
# CTA declares 8 + 8 = 16 B of shared memory (ptxas 13.4 -v: `16 bytes
# smem`); it was read as an `.extern .shared` array sized at launch.
# Addressed by name, every lane at one word: an 8-byte store takes a
# wavefront per half-warp, a load one.
RUN: %ptxroof analyze --dump-ast %fixtures/micro/shared_scalar.ptx | FileCheck --check-prefix=AST "%s"
RUN: %ptxroof analyze %fixtures/micro/shared_scalar.ptx | FileCheck --check-prefix=ANN "%s"
AST-NOT: .extern
AST: .shared .align 8 .b64 total;
AST: .shared .align 8 .b64 count;
ANN: {{^}}.visible .entry micro_shared_scalar( // block 32×1×1 | pointer params assumed 32 B aligned | shared memory 16 B/CTA | per CTA: global store 256 B; shared load 256 B, store 512 B; param load 256 B{{$}}
ANN: {{^}}	st.shared.u64 	[count], %rd3; // shared store [count] wavefronts/req 2 (ideal 2){{$}}
ANN: {{^}}	ld.shared.u64 	%rd4, [count]; // shared load [count] wavefronts/req 1 (ideal 1){{$}}
