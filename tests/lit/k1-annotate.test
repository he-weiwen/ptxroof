# A thread set coupled with the CTA index in the annotated PTX: k1's
# blocks under `row < M && col < N` at M = N = 1000, 16x16 threads and
# 63x63 CTAs run every lane of the 3844 CTAs inside the matrix; the 125
# on its last row and column of CTAs run fewer.
RUN: %ptxroof analyze --annotate --bind param_0=1000 --bind param_1=1000 --bind param_2=1000 --launch 16,16,1 --grid 63,63,1 %fixtures/k1/k1.sm_89.ptx | FileCheck "%s"
CHECK: {{^}}$L__BB0_4: // loop: trips 250 | warp * × lane * in 3844/3969 CTAs, other 125 CTAs differ{{$}}
CHECK: {{^}}$L__BB0_9: // warp * × lane *{{$}}
