# Arithmetic nothing reads as an address, a trip count or a guard is
# not traced: a parameter squared 22 times reports its store at once,
# where tracing the products would build 2^22 factors.
RUN: %ptxroof analyze %fixtures/micro/data_squaring.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.f32 	[%rd1], %f23; // global store [param_0] sectors/req ? (block shape unknown: no .reqntid; pass --launch){{$}}
ANN: {{^}}	st.global.u32 	[%rd1], %r23; // global store [param_0] sectors/req ? (block shape unknown: no .reqntid; pass --launch){{$}}
