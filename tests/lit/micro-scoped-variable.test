# The block's `.shared` array `buf` hides the kernel's register `buf`,
# so the address is the array's, the same in every thread, as ptxas
# compiles it; it was the register's 4 * %tid.x.
RUN: %ptxroof analyze %fixtures/micro/scoped_variable.ptx | FileCheck "%s"
CHECK: kernel micro_scoped_variable
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [param_0 + buf$scope1]
