# shfl.idx from lane 5 reads a floor or mod of %tid.x itself with
# %tid.x at lane 5 of the warp. A thread index under more than one floor
# or mod is no form, but a shuffle from one lane gives the warp one
# value: the address is that value, uniform(%r6@line), one sector a
# warp. A fourth operand other than 31, which splits the warp into
# sub-segments or clamps the lane, leaves it unknown.
RUN: %ptxroof analyze %fixtures/micro/shfl_idx.ptx | FileCheck "%s"
CHECK: kernel micro_shfl_one_floor
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [32 * ⌊%tid.x/32⌋ + param_0 + 4]
CHECK: kernel micro_shfl_bfe
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [4 * uniform(%r6@{{[0-9]+}}) + param_0]
CHECK: kernel micro_shfl_floor_floor
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [4 * uniform(%r6@{{[0-9]+}}) + param_0]
CHECK: kernel micro_shfl_floor_of_mod
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [4 * uniform(%r6@{{[0-9]+}}) + param_0]
CHECK: kernel micro_shfl_laneid
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [4 * uniform(%r6@{{[0-9]+}}) + param_0]
CHECK: kernel micro_shfl_warp_floor
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [4 * uniform(%r6@{{[0-9]+}}) + param_0]
CHECK: kernel micro_shfl_segments
CHECK: st.global.u32  global store 4 B
CHECK-SAME: unknown: shfl.idx in segments of the warp or a clamped lane
CHECK: kernel micro_shfl_clamp_0
CHECK: st.global.u32  global store 4 B
CHECK-SAME: unknown: shfl.idx in segments of the warp or a clamped lane
