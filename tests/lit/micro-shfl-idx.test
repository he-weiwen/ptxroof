# shfl.idx from lane 5 reads a floor or mod of %tid.x itself with
# %tid.x at lane 5 of the warp. A thread index under more than one floor
# or mod is no form, but a shuffle from one lane gives the warp one
# value: the address is that value, uniform(%r6@line), one sector a
# warp request. A fourth operand other than 31, which splits the warp
# into sub-segments or clamps the lane, leaves it unknown.
RUN: %ptxroof analyze --annotate %fixtures/micro/shfl_idx.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [32·⌊%tid.x/32⌋ + param_0 + 4] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [4·uniform(%r6@57) + param_0] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [4·uniform(%r6@76) + param_0] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [4·uniform(%r6@95) + param_0] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [4·uniform(%r6@114) + param_0] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [4·uniform(%r6@133) + param_0] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (shfl.idx in segments of the warp or a clamped lane){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (shfl.idx in segments of the warp or a clamped lane){{$}}
