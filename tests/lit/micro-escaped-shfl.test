# A counter read after a loop whose exit depends on %tid.x, minus lane
# 0's copy of it: ptxas stores thread t at param_0 + 4t. The two reads
# cancel before the counter is checked, so the store reads param_0 for
# every lane. Wrong output; PLAN.md records it.
RUN: %ptxroof analyze %fixtures/micro/escaped_shfl.ptx | FileCheck "%s"
CHECK: kernel micro_escaped_shfl
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [param_0]
