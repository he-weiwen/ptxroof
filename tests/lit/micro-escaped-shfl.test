# A counter read after a loop whose exit depends on %tid.x, minus lane
# 0's copy of it: ptxas stores thread t at param_0 + 4t. The shuffle
# gives the warp lane 0's counter, one value, but each lane's own
# counter differs after the loop, so the address is unknown rather than
# param_0 for every lane.
RUN: %ptxroof analyze %fixtures/micro/escaped_shfl.ptx | FileCheck "%s"
CHECK: kernel micro_escaped_shfl
CHECK: st.global.u32  global store 4 B    unknown: k[$L__BB0_1] differs between lanes after its loop, whose exit depends on %tid.x
