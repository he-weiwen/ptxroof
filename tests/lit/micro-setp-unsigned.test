# `setp.lt.u32` compares unsigned. ptxas runs the first store on threads
# 16 to 47, %tid.x - 16 wrapping below 16, and the second on the
# threads with %tid.x mod 16 == 0, %tid.x << 28 wrapping above 15. An
# unsigned comparison is read only when both operands lie in [0, 2^32)
# on every thread, so in each kernel the store runs on at most the
# CTA's 64 threads: its count, its sectors per request and the CTA's
# global store bytes are bounds.
RUN: %ptxroof analyze --annotate %fixtures/micro/setp_unsigned.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry micro_setp_unsigned( // block 64×1×1 | per CTA: global store <= 256 B; param load 512 B{{$}}
ANN: {{^}}	@%p1 st.global.u32 	[%rd3], %r1; // exec <= 64/CTA | global store [4·%tid.x + param_0] sectors/req <= 5 (ideal 4){{$}}
ANN: {{^}}.visible .entry micro_setp_unsigned_wraps( // block 64×1×1 | per CTA: global store <= 256 B; param load 512 B{{$}}
ANN: {{^}}	@%p1 st.global.u32 	[%rd3], %r1; // exec <= 64/CTA | global store [4·%tid.x + param_0] sectors/req <= 5 (ideal 4){{$}}
