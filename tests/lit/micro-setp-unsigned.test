# Wrong output (PLAN.md): `setp.lt.u32` is read as a signed
# comparison, %tid.x < 48. ptxas runs the store on threads 16 to 47.
RUN: %ptxroof analyze %fixtures/micro/setp_unsigned.ptx | FileCheck "%s"
CHECK: kernel micro_setp_unsigned
CHECK: st.global.u32  global store 4 B on 48 threads in 2 warps (%tid.x < 48)
