# A module-scope array beside a pointer parameter, 512 distinct bytes
# each: the parameter may point into the array, so the base on the
# array has no known pointer and the loop's unique bytes per CTA are
# 512 to 1024, in 1024 to 1280 B of sectors, of the 1024 it requests.
RUN: %ptxroof analyze --annotate %fixtures/micro/uniform_bases_global.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}$L__BB6_1: // loop: trips 4 | global per CTA: requested 1,024 B, unique 512–1,024 B, sectors 1,024–1,280 B | warp * × lane * | exec 128/CTA{{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r2; // global store [4·%tid.x + 128·iv[$L__BB6_1] + gbuf] sectors/req 4–5 (ideal 4){{$}}
