# shfl.idx of %tid.x from lane 0 in a 48x2 block: warps 1 and 2 each
# span both rows, and every lane of a warp stores at one address, one
# sector per warp. The tracer reads lane 0's %tid.x as
# 32 * floor(%tid.x / 32), so those warps read two addresses.
RUN: %ptxroof analyze %fixtures/micro/shfl_2d_block.ptx | FileCheck "%s"
CHECK: kernel micro_shfl_2d_block
CHECK: st.global.u32  global store 4 B  warp: 1–2 sectors (ideal 1)    [128 * ⌊%tid.x/32⌋ + param_0]
