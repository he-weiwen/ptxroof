# Both loops run 10 trips. A latch `setp.lo.u32`, unsigned "lower",
# reads as `setp.lt.u32` does (PTX ISA §9.7.6.2): 10 trips. A latch
# `setp.lt.f16x2`, which compares packed halves, is not a trip count:
# its loop's trips are unknown, and so are the CTA's store bytes, which
# need them.
RUN: %ptxroof analyze %fixtures/micro/latch_forms.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry micro_latch_lo( // block 32×1×1 | pointer params assumed 32 B aligned | per CTA: global store 1,280 B; param load 256 B{{$}}
ANN: {{^}}$L__BB0_1: // loop: trips 10 | global per CTA: requested 1,280 B, unique 4 B, sectors 320 B | warp * × lane * | exec 320/CTA{{$}}
ANN: {{^}}.visible .entry micro_latch_f16x2( // block 32×1×1 | pointer params assumed 32 B aligned | per CTA: global store ? B (trips of $L__BB1_1); param load 256 B{{$}}
ANN: {{^}}$L__BB1_1: // loop: trips ? (latch condition compares packed halves) | warp * × lane * | exec ?{{$}}
