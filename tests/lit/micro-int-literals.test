# Integer literals PTX ISA §4.5.1 allows that the parser misreads, each
# an offset ptxas folds into the store: octal 020 reads as decimal 20,
# where ptxas stores at param_0 + 16; binary 0b10000 and 16U read as
# symbols; 0xfffffffffffffff0, −16, is no integer, and the address a
# uniform variable.
RUN: %ptxroof analyze %fixtures/micro/int_literals.ptx | FileCheck "%s"
CHECK: kernel micro_literal_octal
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [param_0 + 20]
CHECK: kernel micro_literal_binary
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [param_0 + 0b10000]
CHECK: kernel micro_literal_unsigned
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [param_0 + 16U]
CHECK: kernel micro_literal_wide
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [uniform(%rd2@75)]
