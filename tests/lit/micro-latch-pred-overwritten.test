# The latch's last write of %p1 is `and.pred`, not the `setp`, so the
# trip count is not the `setp`'s 10: ptxas runs the loop 3 times.
RUN: %ptxroof analyze %fixtures/micro/latch_pred_overwritten.ptx | FileCheck "%s"
CHECK: kernel micro_latch_pred_overwritten
CHECK: trips = unknown: latch predicate is defined by `and.pred`, not a comparison
