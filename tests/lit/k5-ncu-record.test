# --ncu takes the launch from a measurement record: k5 at M=N=K=256 in
# blocks of 64 threads, the record's u32 parameters bound by position.
RUN: %ptxroof analyze --annotate %fixtures/k5/k5.sm_89.ptx --ncu %fixtures/k5/k5.sm_89.256.ncu.json | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry _Z20hgemm_2d_blocktilingILi64ELi64ELi8ELi8ELi8EEviiifPK6__halfS2_fPS0_( // grid 4×4×1 | block 64×1×1 | param_0 = 256, param_1 = 256, param_2 = 256 | shared memory 2,048 B/CTA | per launch: flops f32 33,751,040; global load 1,179,648 B, store 131,072 B; shared load 8,388,608 B, store 1,048,576 B; param load 40,960 B{{$}}
