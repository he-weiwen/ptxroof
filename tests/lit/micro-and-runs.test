# An and with a mask of several runs of bits is the sum of each run's
# bits, x mod 2^top − x mod 2^low, as 32- and 64-bit masks up to the top
# bit; a value negative on some threads keeps its sign through a run to
# the top bit, read as mul.wide.s32 reads it and refused by mul.wide.u32.
# In a mask of more runs, a run that clears bit 31 of a parameter, whose
# range is unknown, is its remainder mod 2^31. A run from bit 63 above a
# clear bit 62 and a remainder whose modulus does not divide the form's
# offset stay unknown. Each kernel's store, past its `.entry` line,
# prints its address, or `addr ?` and why, and its sectors per warp
# request.
RUN: %ptxroof analyze %fixtures/micro/and_runs.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry micro_and_dc( // block 256×1×1 | pointer params assumed 32 B aligned | per CTA: global store 1,024 B; param load 2,048 B{{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [16·⌊(%tid.x mod 32)/4⌋ + 256·⌊(%tid.x mod 256)/64⌋ + param_0] sectors/req 4 (ideal 1){{$}}
ANN: {{^}}.visible .entry micro_and_46( // block 128×1×1 | pointer params assumed 32 B aligned | per CTA: global store 256 B; param load 1,024 B{{$}}
ANN: {{^}}	st.global.u16 	[%rd3], %rs1; // global store [128·⌊(%tid.x mod 64)/32⌋ + 4·(%tid.x mod 4) + param_0] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}.visible .entry micro_and_top( // block 512×1×1 | pointer params assumed 32 B aligned | per CTA: global store 2,048 B; param load 4,096 B{{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [1024·⌊%tid.x/256⌋ + 4·(%tid.x mod 16) + param_0] sectors/req 2 (ideal 2){{$}}
ANN: {{^}}.visible .entry micro_and_wide( // block 512×1×1 | pointer params assumed 32 B aligned | per CTA: global store 2,048 B; param load 4,096 B{{$}}
ANN: {{^}}	st.global.u32 	[%rd5], %r1; // global store [1024·⌊%tid.x/256⌋ + 4·(%tid.x mod 16) + param_0] sectors/req 2 (ideal 2){{$}}
ANN: {{^}}.visible .entry micro_and_bit63( // block 512×1×1 | per CTA: global store 2,048 B; param load 4,096 B{{$}}
ANN: {{^}}	st.global.u32 	[%rd5], %r1; // global store addr ? (and-mask 0x80000000000000ff keeps bit 63 without 62){{$}}
ANN: {{^}}.visible .entry micro_and_offset( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (depends on special register %tid.x, in a mod){{$}}
ANN: {{^}}.visible .entry micro_and_top_signed( // block 512×1×1 | pointer params assumed 32 B aligned | per CTA: global store 2,048 B; param load 4,096 B{{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [1024·⌊%tid.x/256⌋ + 4·(%tid.x mod 16) + param_0 - 1024] sectors/req 2 (ideal 2){{$}}
ANN: {{^}}.visible .entry micro_and_top_unsigned( // block 512×1×1 | per CTA: global store 2,048 B; param load 4,096 B{{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (`mul.wide.u32` reads a value its type does not hold){{$}}
ANN: {{^}}.visible .entry micro_and_sign_runs( // block 128×1×1 | pointer params assumed 32 B aligned | per CTA: global store 512 B; param load 1,536 B{{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r2; // global store [param_0 + 4·(param_1 mod 16) + 4·(param_1 mod 2147483648) - 4·(param_1 mod 256)] sectors/req 1 (ideal 1){{$}}
