# Counters and sums around u = %ctaid.x / param_1, a uniform variable.
# A counter starting at u itself is no counter: its header φ is the
# variable, uniform(%r4@$L__BB0_1). One starting at a copy of u reads
# u + iv, 256 B a trip, 1024 distinct bytes over the loop, since u is
# fixed in it; after its 4 trips u + 4, and after a loop lanes leave at
# different trips, unknown. In an outer loop that recomputes u, an inner
# counter starting at it reads u + iv of the inner loop. The counter an
# inner loop of u trips steps is a variable of the outer loop,
# uniform(%r6@$L__BB3_1). u − u is 0; u − w keeps both; two values on
# one PTX line are told apart by their place on it.
RUN: %ptxroof analyze %fixtures/micro/uniform_counter.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], %r2; // global store [4·%tid.x + 256·uniform(%r4@$L__BB0_1) + param_0] sectors/req 4–5 (ideal 4){{$}}
ANN: {{^}}$L__BB1_1: // loop: trips 4 | global per CTA: requested 1,024 B, unique 1,024 B, sectors 1,024–1,280 B | warp * × lane * | exec 256/CTA{{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r2; // global store [4·%tid.x + 256·iv[$L__BB1_1] + 256·uniform(%r4@64) + param_0] sectors/req 4–5 (ideal 4){{$}}
ANN: {{^}}	st.global.u32 	[%rd5], %r2; // global store [4·%tid.x + 256·uniform(%r4@64) + param_0 + 1024] sectors/req 4–5 (ideal 4){{$}}
ANN: {{^}}	st.global.u32 	[%rd7], %r2; // global store addr ? ((iv[$L__BB1_3] + 1) differs between lanes after its loop, whose exit depends on %tid.x){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r2; // global store [4·%tid.x + 256·iv[$L__BB2_2] + 256·uniform(%r4@110) + param_0] sectors/req 4–5 (ideal 4){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r2; // global store [4·%tid.x + 256·uniform(%r6@$L__BB3_1) + param_0] sectors/req 4–5 (ideal 4){{$}}
ANN: {{^}}$L__BB3_2: // loop: trips max(uniform(%r4@142), 1) | warp * × lane * | exec (128·max(uniform(%r4@142), 1))/CTA{{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r2; // global store [4·%tid.x + param_0] sectors/req 4–5 (ideal 4){{$}}
ANN: {{^}}	st.global.u32 	[%rd5], %r2; // global store [4·%tid.x + 256·uniform(%r4@175) - 256·uniform(%r6@177) + param_0] sectors/req 4–5 (ideal 4){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r2; // global store [4·%tid.x + 256·uniform(%r4@205.1) + 256·uniform(%r6@205.2) + param_0] sectors/req 4–5 (ideal 4){{$}}
