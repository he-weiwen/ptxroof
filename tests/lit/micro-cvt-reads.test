# A bf16x2 pack and an integer-to-float conversion change the value's
# bits, and a cvt.u32.u64 of %tid.x + 2^32 (64 threads, from .reqntid)
# leaves 32 bits: all three addresses are unknown.
RUN: %ptxroof analyze %fixtures/micro/cvt_reads.ptx | FileCheck "%s"
CHECK: kernel micro_cvt_reads
CHECK: st.global.u32  global store 4 B    unknown: `cvt.rn.bf16x2.f32` is not an integer conversion
CHECK: st.global.u32  global store 4 B    unknown: `cvt.rn.f32.u32` is not an integer conversion
CHECK: st.global.u32  global store 4 B    unknown: `cvt.u32.u64` leaves 32 bits
