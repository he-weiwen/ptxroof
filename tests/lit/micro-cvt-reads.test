# Wrong output (PLAN.md): every `cvt` is read as its last operand
# unchanged. The first two addresses are not 4·%tid.x, and the third
# has no 2^34 term.
RUN: %ptxroof analyze %fixtures/micro/cvt_reads.ptx | FileCheck "%s"
CHECK: kernel micro_cvt_reads
CHECK: st.global.u32  global store 4 B  warp: 4–5 sectors (ideal 4)    [4 * %tid.x + param_0]
CHECK: st.global.u32  global store 4 B  warp: 4–5 sectors (ideal 4)    [4 * %tid.x + param_0]
CHECK: st.global.u32  global store 4 B  warp: 4–5 sectors (ideal 4)    [4 * %tid.x + param_0 + 17179869184]
