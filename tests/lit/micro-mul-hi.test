# mul.hi of 2 and 3 is 0, and ptxas stores at param_0; mad.hi of 2, 3
# and 1 is 0 + 1 (PTX ISA §9.7.1.4), a[1]. The upper half of a product
# is no affine form, so both addresses are unknown.
RUN: %ptxroof analyze %fixtures/micro/mul_hi.ptx | FileCheck "%s"
CHECK: kernel micro_mul_hi
CHECK: st.global.u32  global store 4 B    unknown: `mul.hi.u32` keeps a product's upper half
CHECK: st.global.u32  global store 4 B    unknown: `mad.hi.u32` keeps a product's upper half
