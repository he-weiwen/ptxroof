# mul.hi of 2 and 3 is 0, and ptxas stores at param_0; mad.hi of 2, 3
# and 1 is 0 + 1 (PTX ISA §9.7.1.4), a[1]. The upper half of a product
# is no affine form; every thread computes the same value, so each
# address is read with it as a uniform variable, one sector per warp.
RUN: %ptxroof analyze %fixtures/micro/mul_hi.ptx | FileCheck "%s"
CHECK: kernel micro_mul_hi
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [4 * uniform(%r2@27) + param_0]
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [4 * uniform(%r3@31) + param_0]
