# Wrong output (PLAN.md): `%v.x` is a register of its own, apart from the
# vector register %v, so after a load overwrites %v it is still the
# thread index. ptxas takes the address from the load.
RUN: %ptxroof analyze %fixtures/micro/vector_register.ptx | FileCheck "%s"
CHECK: kernel micro_vector_register
CHECK: st.global.u32 {{ +}}global store 4 B  warp: 4–5 sectors (ideal 4)    [4 * %tid.x + param_0]
