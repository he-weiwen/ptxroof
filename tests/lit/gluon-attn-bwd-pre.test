# Backward preprocess: D = sum(dO * O) per row, one block, masked store.
RUN: %ptxroof analyze %fixtures/gluon/attn_bwd_pre_kernel.sm_89.ptx | FileCheck "%s"
CHECK: kernel attn_bwd_pre_kernel
CHECK: block size: 128 threads, 4 warps (128x1x1 from .reqntid)
CHECK: flops = 136  (f32 136)
CHECK: global bytes: load 256 B, store <= 16 B
CHECK: unknowns: none
