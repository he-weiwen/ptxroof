# Backward preprocess: D = sum(dO * O) per row, one block run once by
# each of the 128 threads `.reqntid` sets: 136 f32 flops and 256 B
# loaded per thread, 128 times that per CTA; the masked stores run on 16
# threads each, 256 B per CTA.
RUN: %ptxroof analyze %fixtures/gluon/attn_bwd_pre_kernel.sm_89.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}.visible .entry attn_bwd_pre_kernel( // block 128×1×1 | pointer params assumed 32 B aligned | per CTA: flops f32 17,408; global load 32,768 B, store 256 B; param load 5,632 B{{$}}
ANN: {{^}}$L__func_begin0: // warp * × lane * | exec 128/CTA{{$}}
ANN: {{^}}	@%p1 st.global.b32 [ %rd17 + 0 ], { %r65 }; // warp * × lane 0-24:8 | exec 16/CTA | global store [256·%ctaid.x + (4·param_7)·%ctaid.y + 4·(⌊%tid.x/8⌋ mod 16) + param_2] sectors/req 1–2 (ideal 1){{$}}
