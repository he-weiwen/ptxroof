# micro/irreducible under its record at param 1 = 32: every instruction
# is classified, and its cycle, which belongs to no natural loop, has no
# trip count to resolve.
RUN: %ptxroof analyze %fixtures/micro/irreducible.ptx --ncu %fixtures/micro/irreducible.32.ncu.json --json | %check-report "%s"
{
