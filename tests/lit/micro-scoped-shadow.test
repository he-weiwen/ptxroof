# The `.reg` named %laneid in a nested scope takes the name there only,
# so the read after the scope is the lane index, as ptxas reads it
# (`SR_LANEID`).
RUN: %ptxroof analyze --annotate %fixtures/micro/scoped_shadow.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [4·(%tid.x mod 32) + param_0] sectors/req 4–5 (ideal 4){{$}}
