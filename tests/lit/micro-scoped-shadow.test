# Wrong output (PLAN.md): the `.reg` named %laneid in a nested scope
# takes the name in the whole kernel, so the read after the scope is
# its 0 and every thread stores to param_0. ptxas reads the lane
# index there: 4 sectors.
RUN: %ptxroof analyze %fixtures/micro/scoped_shadow.ptx | FileCheck "%s"
CHECK: kernel micro_scoped_shadow
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [param_0]
