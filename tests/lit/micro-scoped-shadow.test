# The `.reg` named %laneid in a nested scope takes the name there only,
# so the read after the scope is the lane index, as ptxas reads it
# (`SR_LANEID`).
RUN: %ptxroof analyze %fixtures/micro/scoped_shadow.ptx | FileCheck "%s"
CHECK: kernel micro_scoped_shadow
CHECK: st.global.u32  global store 4 B  warp: 4–5 sectors (ideal 4)    [4 * (%tid.x mod 32) + param_0]
