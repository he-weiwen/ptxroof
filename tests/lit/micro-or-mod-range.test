# A remainder's greatest value under the block shape: %tid.x mod 64 is
# below 32 in a block of 32, so its `or` with 32 is an add, 4 sectors per
# warp request, as an RTX 4090 run touches.
RUN: %ptxroof analyze %fixtures/micro/or_mod_range.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], 1; // global store [4·(%tid.x mod 64) + param_0 + 128] sectors/req 4 (ideal 4){{$}}
