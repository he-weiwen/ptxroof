# A write that fails for another reason than a closed pipe is an error.
# bash redirects to /dev/full: on a failed command lit reads back the
# files it redirected to, and /dev/full reads as endless zeros. macOS has
# no /dev/full.
REQUIRES: dev-full
RUN: not bash -c '"$0" analyze "$1" > /dev/full' %ptxroof %fixtures/micro/branchy.ptx 2> "%t.err"
RUN: FileCheck --check-prefix=ANN "%s" < "%t.err"
ANN: ptxroof: writing stdout: No space left on device
