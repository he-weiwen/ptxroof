# A loop's count read after it is named one way in every reason, as its
# iteration from 0 plus one: the store's address and the second loop's
# trips both read `(iv[$L__BB0_1] + 1)`.
RUN: %ptxroof analyze %fixtures/micro/counter_names.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? ((iv[$L__BB0_1] + 1) differs between lanes after its loop, whose exit depends on %tid.x){{$}}
ANN: {{^}}$L__BB0_3: // loop: trips ? ((iv[$L__BB0_1] + 1) differs between lanes after its loop, whose exit depends on %tid.x) | warp * × lane * | exec ?{{$}}
