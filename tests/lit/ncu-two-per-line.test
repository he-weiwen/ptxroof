# Two fma.rn.f32 on one line: the record counts the line's 64 FFMA
# executions together, so neither instruction is compared; the block
# rests on its other lines.
RUN: %ptxroof analyze "%S/Inputs/ncu-two-per-line.ptx" --ncu "%S/Inputs/ncu-two-per-line.ncu.json" --json | %check-report "%s"
{
  "kernels": [
    {
      "measured": [
        {"name": "<block 0>", "verdict": "consistent", "instructions": 7, "with_sass": 6, "agreeing": 3}
      ]
    }
  ],
  "coverage": {"instructions_classified": {"num": 7, "den": 7}, "loop_trips_resolved": {"num": 0, "den": 0}}
}
