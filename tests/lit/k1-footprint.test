# k1 at M=N=K=256, block 32x32, grid 8x8: every lane of a warp reads the
# same A element (1 sector) and consecutive B and C elements (2). Nsight
# Compute on this launch: 1,050,624 load requests over 1,576,960
# sectors and 2,048 store requests over 4,096, exactly these lines'
# sectors per request times their counts. The K loop's global bytes per
# CTA: 1,048,576 B requested, 32,768 B unique. The guard `x < M && y <
# N` reads only with M and the grid bound; without them which threads
# run the loop is not known, and its footprint is a bound.
RUN: %ptxroof analyze %fixtures/k1/k1.sm_80.ptx --bind 0:M=256 --bind 1:N=256 --bind 2:K=256 --launch 32,32,1 --grid 8,8,1 | FileCheck --check-prefix=ANN "%s"
RUN: %ptxroof analyze %fixtures/k1/k1.sm_80.ptx --bind 1:N=256 --bind 2:K=256 --launch 32,32,1 | FileCheck --check-prefix=FREE "%s"
ANN: {{^}}.visible .entry _Z11hgemm_naiveiiifPK6__halfS1_fPS_( // grid 8×8×1 | block 32×32×1 | param_0 = 256, param_1 = 256, param_2 = 256 | per launch: flops f32 33,751,040; global load 67,239,936 B, store 131,072 B; param load 2,883,584 B{{$}}
ANN: {{^}}$L__BB0_4: // loop: trips 64 | global per CTA: requested 1,048,576 B, unique 32,768 B, sectors 786,432–1,048,576 B | warp * × lane * | exec 4,194,304/launch{{$}}
ANN: {{^}}	ld.global.u16 	%rs1, [%rd25]; // global load [512·%tid.y + 16384·%ctaid.y + 8·iv[$L__BB0_4] + param_4] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	ld.global.u16 	%rs2, [%rd15]; // global load [2·%tid.x + 64·%ctaid.x + 2048·iv[$L__BB0_4] + param_5] sectors/req 2–3 (ideal 2){{$}}
ANN: {{^}}	ld.global.u16 	%rs11, [%rd24]; // global load [2·%tid.x + 512·%tid.y + 64·%ctaid.x + 16384·%ctaid.y + param_7] sectors/req 2–3 (ideal 2){{$}}
ANN: {{^}}	st.global.u16 	[%rd24], %rs12; // global store [2·%tid.x + 512·%tid.y + 64·%ctaid.x + 16384·%ctaid.y + param_7] sectors/req 2–3 (ideal 2){{$}}
FREE: {{^}}$L__BB0_4: // loop: trips 64 | global per CTA: requested <= 1,048,576 B, unique <= 32,768 B, sectors <= 786,432–1,048,576 B | <= warp * × lane * | exec <= 65,536/CTA{{$}}
