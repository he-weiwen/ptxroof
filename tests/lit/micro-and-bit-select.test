# An and of a mask with a value of 0 or −1 is −mask times the value: the
# bit select −(%tid.x & 1) & 576 is 576·(%tid.x mod 2), 32- and 64-bit.
# A mask with the sign bit and a value below −1 stay unknown; %ctaid.x's
# bit needs the grid for its range, and is a uniform variable without
# it, a multiple of 64. An or of the select with another bit adds them,
# 2080·(%tid.x mod 2) setting bits 5 and 11 only, and a select by a
# signed bfe of one bit is minus that bit. A 16-bit −1 widened by
# mul.wide.u16 is refused; an and.b16 takes its mask's 16 bits; −2^63
# as a coefficient prints whole.
# A select of a value that div.u32 reads as 0x7fffffff, not −1, is no
# select: the division is refused and its guard a bound. Each kernel's
# store, past its `.entry` line, prints its address, or `addr ?` and
# why, and its sectors per warp request.
RUN: %ptxroof analyze %fixtures/micro/and_bit_select.ptx | FileCheck --check-prefix=FREE "%s"
RUN: %ptxroof analyze %fixtures/micro/and_bit_select.ptx --grid 4,1,1 | FileCheck --check-prefix=GRID "%s"
FREE: {{^}}.visible .entry micro_and_select( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd3], %r1; // global store [2304·(%tid.x mod 2) + param_0] sectors/req 2 (ideal 1){{$}}
FREE: {{^}}.visible .entry micro_and_select_wide( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd7], %r1; // global store [2304·(%tid.x mod 2) + param_0] sectors/req 2 (ideal 1){{$}}
FREE: {{^}}.visible .entry micro_and_select_sign( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (depends on special register (%tid.x mod 2), in a mod){{$}}
FREE: {{^}}.visible .entry micro_and_select_two_bits( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (depends on special register (%tid.x mod 4), in a mod){{$}}
FREE: {{^}}.visible .entry micro_and_select_grid( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd3], %r1; // global store [4·uniform(%r5@154) + param_0] sectors/req 1 (ideal 1){{$}}
FREE: {{^}}.visible .entry micro_and_select_or( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd3], %r1; // global store [512·⌊(%tid.x mod 16)/8⌋ + 8320·(%tid.x mod 2) + param_0] sectors/req 4 (ideal 1){{$}}
FREE: {{^}}.visible .entry micro_and_select_bfe( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd3], %r1; // global store [16640·(⌊%tid.x/4⌋ mod 2) + param_0] sectors/req 2 (ideal 1){{$}}
FREE: {{^}}.visible .entry micro_and_select_widened( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (`mul.wide.u16` reads a value its type does not hold){{$}}
FREE: {{^}}.visible .entry micro_and_select_b16( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd3], %r1; // global store [4·(%tid.x mod 2) + param_0] sectors/req 1–2 (ideal 1){{$}}
FREE: {{^}}.visible .entry micro_and_select_b16_sign( // block 128×1×1 | per CTA: global store 512 B; param load 1,024 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd3], %r1; // global store [-4·(%tid.x mod 2) + param_0] sectors/req 1–2 (ideal 1){{$}}
FREE: {{^}}.visible .entry micro_and_select_min( // block 1×1×1 | per CTA: global store 4 B; param load 8 B{{$}}
FREE: {{^}}	st.global.u32 	[%rd6], %r1; // global store [(-9223372036854775808)·%tid.x + param_0 + 4611686018427387904] sectors/req 1 (ideal 1){{$}}
FREE: {{^}}.visible .entry micro_and_select_divided( // block 128×1×1 | per CTA: global store <= 512 B; param load 1,024 B{{$}}
FREE: {{^}}	@%p1 st.global.u32 	[%rd1], %r1; // <= warp * × lane * | exec <= 128/CTA | global store [param_0] sectors/req <= 1 (ideal <= 1){{$}}
GRID: {{^}}.visible .entry micro_and_select_grid( // grid 4×1×1 | block 128×1×1 | per launch: global store 2,048 B; param load 4,096 B{{$}}
GRID: {{^}}	st.global.u32 	[%rd3], %r1; // global store [2304·(%ctaid.x mod 2) + param_0] sectors/req 1 (ideal 1){{$}}
