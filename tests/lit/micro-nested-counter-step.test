# A counter the inner loop steps 4 times per outer trip, read after it:
# ptxas stores 16 B apart, at param_0 + 0x10 to + 0x80. The outer
# counter steps by the inner loop's exit, 4 trips of 1, and the read
# after the inner loop takes its counter at 4.
RUN: %ptxroof analyze %fixtures/micro/nested_counter_step.ptx | FileCheck "%s"
CHECK: kernel micro_nested_counter_step
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [16 * k[$L__BB0_1] + param_0]  k[$L__BB0_1]: +16 B/iter
