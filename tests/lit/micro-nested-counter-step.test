# A counter the inner loop steps 4 times per outer trip, read after it:
# ptxas stores 16 B apart, at param_0 + 0x10 to + 0x80. A write in the
# inner loop is no step of the outer one, so the address is unknown
# until exit values.
RUN: %ptxroof analyze %fixtures/micro/nested_counter_step.ptx | FileCheck "%s"
CHECK: kernel micro_nested_counter_step
CHECK: st.global.u32  global store 4 B    unknown: depends on %r1, carried around an enclosing loop
