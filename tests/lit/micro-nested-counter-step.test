# A counter the inner loop steps 4 times per outer trip, read after it:
# ptxas stores 16 B apart, at param_0 + 0x10 to + 0x80; the outer loop
# takes the inner `add` as one step per trip, 4 B.
RUN: %ptxroof analyze %fixtures/micro/nested_counter_step.ptx | FileCheck "%s"
CHECK: kernel micro_nested_counter_step
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [4 * k[$L__BB0_1] + param_0]  k[$L__BB0_1]: +4 B/iter
