# A loop counter's range under the bindings: the store's `or` of 4·k and
# %tid.x << 8 is an add only while 4·k < 256. Under the record, with n
# = 32, the counter runs 1..32 and the address reads, 32 sectors per
# warp request; with n unbound or 100 the or may set bit 8 and the
# address is unknown.
RUN: %ptxroof analyze %fixtures/micro/counter_range_bound.ptx | FileCheck --check-prefix=ANN-FREE "%s"
RUN: %ptxroof analyze %fixtures/micro/counter_range_bound.ptx --bind 1:n=100 | FileCheck --check-prefix=ANN-FREE "%s"
RUN: %ptxroof analyze %fixtures/micro/counter_range_bound.ptx --ncu %fixtures/micro/counter_range_bound.ncu.json | FileCheck --check-prefix=ANN-REC "%s"
ANN-FREE: {{^}}	st.global.u32 	[%rd3], %r4; // global store addr ? (or whose sides may both set bit 8){{$}}
ANN-REC: {{^}}$L__BB0_2: // loop: trips 32 | global per CTA: requested 16,384 B, unique 16,384 B, sectors 131,072 B | warp * × lane * | exec 4,096/launch{{$}}
ANN-REC: {{^}}	st.global.u32 	[%rd3], %r4; // global store [1024·%tid.x + 16·iv[$L__BB0_2] + param_0 + 16] sectors/req 32 (ideal 4){{$}}
