# `ld.u32 %r2, [%rd1].unified` is parsed, a generic load from param_0,
# and loads into %r2, so the store's address after it comes from memory
# and is unknown; it was unparsed, and the address read as
# `4 * %tid.x + param_0`.
RUN: %ptxroof analyze --annotate %fixtures/micro/unified_load.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	ld.u32 	%r2, [%rd1].unified; // generic load [param_0] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (depends on a value loaded from memory){{$}}
