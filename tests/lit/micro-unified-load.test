# `ld.u32 %r2, [%rd1].unified` is parsed and loads into %r2, so the
# store's address after it comes from memory; it was unparsed, and the
# address read as `4 * %tid.x + param_0`.
RUN: %ptxroof analyze %fixtures/micro/unified_load.ptx | FileCheck "%s"
CHECK: kernel micro_unified_load
CHECK: st.global.u32  global store 4 B {{ +}}unknown: depends on a value loaded from memory
CHECK-NOT: unparsed
