# A latch comparison only lanes below 32 run, %p2 starting false:
# ptxas keeps the false for lanes 32-63, which leave after 1 trip and
# store at param_0 + 4, while lanes 0-31 run 4 trips and store at + 16.
# The trip count refuses the guarded comparison, and the store's
# counter differs by lane.
RUN: %ptxroof analyze %fixtures/micro/guarded_latch_setp.ptx | FileCheck "%s"
CHECK: kernel micro_guarded_latch_setp
CHECK: trips = unknown: %p2 is written under a guard
CHECK: st.global.u32  global store 4 B    unknown: k[$L__BB0_1] differs between lanes after its loop, whose exit depends on %tid.x
