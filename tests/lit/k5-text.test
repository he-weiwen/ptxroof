ANN: {{^}}	ld.global.u16 	%rs9, [%rd31]; // global load [128·%ctaid.x + (16·param_1)·iv[$L__BB0_2] + (2·param_1)·⌊%tid.x/64⌋ + 2·(%tid.x mod 64) + param_5] sectors/req ? (the coefficient of ⌊%tid.x/64⌋ is 2·param_1; bind it){{$}}
