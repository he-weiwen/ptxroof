# `mov.u32 %r2, buf+8` and `ld.local.u32 %r3, [0]` are parsed: the first
# store is at the array's address in every thread, the second's comes
# from local memory. Both were unparsed and read as `4 * %tid.x + param_0`;
# ptxas stores the first to param_0 + 32.
RUN: %ptxroof analyze %fixtures/micro/address_operands.ptx | FileCheck "%s"
CHECK: kernel micro_address_operands
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [param_0 + 4 * buf + 32]
CHECK: st.global.u32  global store 4 B {{ +}}unknown: depends on a value loaded from memory
CHECK-NOT: unparsed
