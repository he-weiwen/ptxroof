# `mov.u32 %r2, buf+8` and `ld.local.u32 %r3, [0]` are parsed: the first
# store is at the array's address in every thread; the second's comes
# from local memory, through a load from an immediate address that is
# not traced. Both were unparsed and read as `4 * %tid.x + param_0`;
# ptxas stores the first to param_0 + 32.
RUN: %ptxroof analyze %fixtures/micro/address_operands.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store [param_0 + 4·buf + 32] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	ld.local.u32 	%r3, [0]; // local load addr ? (address operand form not traced){{$}}
ANN: {{^}}	st.global.u32 	[%rd5], %r1; // global store addr ? (depends on a value loaded from memory){{$}}
