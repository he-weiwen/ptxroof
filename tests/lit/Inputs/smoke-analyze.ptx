//
// HAND-WRITTEN: smoke input for the analyze verb; also proves the
// runner's {case} placeholder expansion. One counted loop.
//
.version 8.7
.target sm_80
.address_size 64

.visible .entry micro_smoke(
	.param .u64 micro_smoke_param_0,
	.param .u32 micro_smoke_param_1
)
{
	.reg .pred 	%p<3>;
	.reg .f32 	%f<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [micro_smoke_param_0];
	ld.param.u32 	%r1, [micro_smoke_param_1];
	cvta.to.global.u64 	%rd2, %rd1;
	setp.lt.s32 	%p1, %r1, 1;
	@%p1 bra 	$L__BB0_3;

	mov.u32 	%r2, 0;
	mov.u64 	%rd3, %rd2;

$L__BB0_2:
	ld.global.f32 	%f1, [%rd3];
	fma.rn.f32 	%f2, %f1, %f1, 0f3F800000;
	st.global.f32 	[%rd3], %f2;
	add.s64 	%rd3, %rd3, 4;
	add.s32 	%r2, %r2, 1;
	setp.lt.s32 	%p2, %r2, %r1;
	@%p2 bra 	$L__BB0_2;

$L__BB0_3:
	ret;

}
