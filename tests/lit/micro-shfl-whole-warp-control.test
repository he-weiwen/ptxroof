# A `shfl.sync.idx` control of clamp 31 and no segment mask reads the
# whole warp whatever its other bits: control 127 reads lane 5 as 31
# does, words 5 and 37 of 64 threads, as an RTX 4090 run stores.
RUN: %ptxroof analyze %fixtures/micro/shfl_whole_warp_control.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], 1; // global store [128·⌊%tid.x/32⌋ + param_0 + 20] sectors/req 1 (ideal 1){{$}}
