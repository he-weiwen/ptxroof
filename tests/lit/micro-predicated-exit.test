# Wrong output (PLAN.md): a predicated `exit` is read as falling
# through, so the store after it counts on every thread, exactly; on
# an RTX 4090 at n = 20 it runs on none.
RUN: %ptxroof analyze %fixtures/micro/predicated_exit.ptx --ncu %fixtures/micro/predicated_exit.ncu.json | FileCheck "%s"
CHECK-LABEL: kernel micro_predicated_exit
CHECK: totals [static]:
CHECK: global bytes: load 0 B, store 4 B
CHECK: line 28: st.global.u32 [%rd1], %r1;  predicted 32, measured 0
