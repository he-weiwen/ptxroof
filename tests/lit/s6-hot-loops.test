# S6 (PLAN.md, acceptance scenarios): where does the work go? k2's
# unrolled main loop runs (param_2 - param_2 mod 4) / 4 trips and its
# nounroll remainder param_2 mod 4, each a bound per thread since a
# branch before it may skip it.
RUN: %ptxroof analyze %fixtures/k2/k2.sm_80.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}$L__BB0_4: // loop: trips (param_2 - param_2 mod 4) / 4 | under line 80 | exec <= ((param_2 - param_2 mod 4) / 4)/thread{{$}}
ANN: {{^}}$L__BB0_7: // loop: trips param_2 mod 4 | under line 173 | exec <= (param_2 mod 4)/thread{{$}}
