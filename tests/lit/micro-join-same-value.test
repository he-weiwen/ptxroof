# A φ at a join whose paths write one value reads as that value: census
# kernel 00004.ptx's %tid.x, written on both paths of a branch, gives
# the store its address and its threads. Paths that write different
# values stay unknown with the obstacle of a definition, and so do
# paths that write one value through a loop counter (census kernel
# 00376.ptx; PLAN.md).
RUN: %ptxroof analyze %fixtures/micro/join_same_value.ptx | FileCheck "%s"
CHECK: kernel micro_join_same_tid
CHECK: $L__BB0_3  st.global.u32  global store 4 B on 64 threads in 2 warps (64 * ⌊(%tid.x mod 128)/64⌋ == 0)
CHECK-SAME: warp: 4–5 sectors (ideal 4)
CHECK-SAME: [256 * %ctaid.y + 4 * (%tid.x mod 64) + param_0]
CHECK: kernel micro_join_two_values
CHECK: $L__BB1_3  st.global.u32  global store 4 B    unknown: depends on special register %tid.x
CHECK: kernel micro_join_counter
CHECK: $L__BB2_4  st.global.u32  global store 4 B    unknown: depends on special register %tid.x
