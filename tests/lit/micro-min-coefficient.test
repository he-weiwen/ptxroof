# A coefficient or an offset of −2^63 prints whole, also negated, which
# keeps the product −1 · −2^63; no magnitude is taken of it.
RUN: %ptxroof analyze --annotate %fixtures/micro/min_coefficient.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd5], %r1; // global store [(-9223372036854775808)·%tid.x + param_0] sectors/req 1 (ideal 1){{$}}
ANN: {{^}}	st.global.u32 	[%rd6], %r1; // global store [-(-9223372036854775808)·%tid.x + param_0] sectors/req ? (the coefficient of %tid.x is -1·-9223372036854775808; bind it){{$}}
ANN: {{^}}	st.global.u32 	[%rd4], %r1; // global store [param_0 + -9223372036854775808] sectors/req 1 (ideal 1){{$}}
