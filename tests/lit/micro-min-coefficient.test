# A coefficient or an offset of −2^63 prints whole, also negated, which
# keeps the product −1 · −2^63; no magnitude is taken of it.
RUN: %ptxroof analyze %fixtures/micro/min_coefficient.ptx | FileCheck "%s"
CHECK: kernel micro_min_coefficient
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [(-9223372036854775808) * %tid.x + param_0]
CHECK: kernel micro_min_negated
CHECK: st.global.u32  global store 4 B
CHECK-SAME: [-(-9223372036854775808) * %tid.x + param_0]
CHECK: kernel micro_min_base
CHECK: st.global.u32  global store 4 B  warp: 1 sector (ideal 1)
CHECK-SAME: [param_0 + -9223372036854775808]
