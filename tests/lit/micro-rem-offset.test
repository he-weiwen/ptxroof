# A remainder whose constant passes the coefficient of the term the
# modulus does not divide reads where that term's range keeps it below
# the modulus: census kernel 01890.ptx's (64·%ctaid.y | ⌊%tid.x/8⌋ mod
# 16 | 16) rem seq_len under its binding, whatever the launch, and
# ⌊%tid.x/64⌋ + 62 in blocks of 128. One that passes the modulus stays
# unknown.
RUN: %ptxroof analyze --bind 1:n=64 %fixtures/micro/rem_offset.ptx | FileCheck "%s"
CHECK: kernel micro_rem_offset_mod
CHECK: <block 0>  st.global.u32  global store 4 B  warp: 1–2 sectors (ideal 1)    [4 * (⌊%tid.x/8⌋ mod 16) + param_0 + 64]
CHECK: kernel micro_rem_offset_block
CHECK: <block 0>  st.global.u32  global store 4 B  warp: 1 sector (ideal 1)  [4 * ⌊%tid.x/64⌋ + param_0 + 248]
CHECK: kernel micro_rem_offset_wraps
CHECK: <block 0>  st.global.u32  global store 4 B    unknown: depends on special register %ctaid.y, in a division
