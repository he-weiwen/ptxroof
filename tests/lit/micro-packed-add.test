# `add.s16x2` adds the halves of 0xffff and the thread index apart, so
# thread t >= 1 stores at param_0 + 4·(t - 1) (ptxas 13.4:
# `VIADD.16x2`). A packed add is not read as one 32-bit add: the
# store's address is unknown.
RUN: %ptxroof analyze %fixtures/micro/packed_add.ptx | FileCheck --check-prefix=ANN "%s"
ANN: {{^}}	st.global.u32 	[%rd3], %r1; // global store addr ? (`add.s16x2` computes per packed lane){{$}}
